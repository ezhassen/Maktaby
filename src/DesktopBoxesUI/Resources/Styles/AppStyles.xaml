    <!--
        Box appearance resources. These are resolved from UserSettings by BoxAppearance and
        applied at runtime (App.ApplyBoxAppearance / BoxContainerWindow.ApplyAppearance), so
        boxes follow the configured theme and colors. Declared here only as safe defaults.
    -->

    <!--
        Borderless button that blends into its parent (transparent background, no border).
        Used for the title-bar icon buttons (menu, roll).
    -->
    <Style x:Key="BorderlesButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Background" Property="Background" Value="#24FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Background" Property="Background" Value="#3BFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Fixed WPF-UI menu item templates.
        
        The stock WPF-UI MenuItem.SubmenuHeaderTemplate applies a template-local DropShadowEffect and
        offsets that make submenus OVERLAP their parent item instead of opening beside it whenever the
        menu opens upward (bottom-anchored). These app-wide replacements remove the shadow, anchor the
        submenu Popup to the RIGHT of its parent row, and ADD what the stock templates lack: a check
        gutter so IsCheckable items (tray "Hide All Boxes", per-box "Icon Size" presets, ...) render
        their checked state.
    -->
    <ControlTemplate x:Key="FixedSubmenuItemTemplate" TargetType="MenuItem">
        <Border
            x:Name="Border"
            Margin="4,2,4,2"
            Background="Transparent"
            CornerRadius="5">
            <Grid Margin="8,7,8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Modern check box: 16x16 rounded, bigger glyph, visible only when checked.  -->
                <Grid
                    x:Name="CheckContainer"
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    Margin="0,0,6,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Border
                        x:Name="CheckBox"
                        Background="#2B88D8"
                        BorderBrush="#2B88D8"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <Path
                        x:Name="CheckGlyph"
                        Width="10"
                        Height="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M1,4.8 L4.2,7.6 L9.2,1.2"
                        Stretch="None"
                        Stroke="White"
                        StrokeEndLineCap="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.7" />
                </Grid>

                <ContentPresenter
                    x:Name="IconPresenter"
                    Grid.Column="1"
                    Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Icon}" />

                <ContentPresenter
                    x:Name="Header"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckContainer" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FixedSubmenuHeaderTemplate" TargetType="MenuItem">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="Border"
                Grid.Row="1"
                Margin="4,2,4,2"
                Background="Transparent"
                CornerRadius="5">
                <Grid Margin="8,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        x:Name="CheckContainer"
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Border
                            x:Name="CheckBox"
                            Background="#2B88D8"
                            BorderBrush="#2B88D8"
                            BorderThickness="1"
                            CornerRadius="4" />
                        <Path
                            x:Name="CheckGlyph"
                            Width="10"
                            Height="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M1,4.8 L4.2,7.6 L9.2,1.2"
                            Stretch="None"
                            Stroke="White"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.7" />
                    </Grid>

                    <ContentPresenter
                        x:Name="IconPresenter"
                        Grid.Column="1"
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Icon}" />

                    <ContentPresenter
                        x:Name="Header"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True" />

                    <Path
                        Grid.Column="3"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Data="M0,0 L5,4 L0,8 Z"
                        Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" />
                </Grid>
            </Border>

            <!--  Anchored RIGHT of the parent row: fixes the bottom-open overlap bug. No DropShadowEffect.  -->
            <Popup
                x:Name="Popup"
                Grid.Row="1"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsSubmenuOpen}"
                Placement="Right"
                PlacementTarget="{Binding ElementName=Border}"
                PopupAnimation="None">
                <Border
                    Padding="12,6,12,6"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                    <ScrollViewer CanContentScroll="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckContainer" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Role-routed application of the fixed templates. Only Submenu* roles are replaced; top-level
        roles keep the WPF-UI defaults (context menus never use them anyway).
    -->
    <Style TargetType="MenuItem">
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource FixedSubmenuHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource FixedSubmenuItemTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
