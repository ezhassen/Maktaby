<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Windows-only desktop app: platform guard (CA1416) is unnecessary noise. -->
		<!--<NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>-->
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<RootNamespace>DesktopBoxesUI</RootNamespace>
		<AssemblyName>DesktopBoxesUI</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDefaultPageItems>true</EnableDefaultPageItems>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<!--
      WPF / COM / Win32 compatibility will be evaluated for trimming and Native AOT
      later. For now we intentionally do NOT enable trimming or AOT. We only enable
      the trim analysis-friendly patterns to keep the code prepared.
    -->
		<IsTrimmable>false</IsTrimmable>
		<EnableAot>false</EnableAot>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="WPF-UI" Version="4.3.0" />
		<PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- CsWin32 auto-discovers NativeMethods.txt only at the project root, so register our
         isolated copy explicitly. All raw Win32 declarations live in this one file. -->
		<AdditionalFiles Include="Win32\NativeMethods\NativeMethods.txt" />
	</ItemGroup>

</Project>
