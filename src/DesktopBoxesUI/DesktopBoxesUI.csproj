<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Windows-only desktop app: platform guard (CA1416) is unnecessary noise. -->
		<!--<NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>-->
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<RootNamespace>DesktopBoxesUI</RootNamespace>
		<AssemblyName>DesktopBoxesUI</AssemblyName>
		<Description>Desktop Boxes - organize your desktop into resizable boxes that pin files, folders and app shortcuts above the Windows desktop.</Description>
		<AssemblyTitle>Desktop Boxes - desktop organizer</AssemblyTitle>
		<Product>Desktop Boxes</Product>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>		
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDefaultPageItems>true</EnableDefaultPageItems>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<!--
      WPF / COM / Win32 compatibility will be evaluated for trimming and Native AOT
      later. For now we intentionally do NOT enable trimming or AOT. We only enable
      the trim analysis-friendly patterns to keep the code prepared.
    -->
		<IsTrimmable>false</IsTrimmable>
		<EnableAot>false</EnableAot>
		<Platforms>AnyCPU;x64</Platforms>
		<!--
      .NET 9/10 enable CET (shadow stacks) by default. The UAC elevation path used by
      "Run as administrator" (Process.Start with Verb="runas") crashes natively
      (ntd.dll 0xc0000409) on CET-capable CPUs when the binary is CET-marked. This is an
      uncatchable native fault, so disable CET marking for this binary.
    -->
		<CETCompat>false</CETCompat>

		<Authors>Ezz Hassan</Authors>
		<Company>Ezz Hassan</Company>
		<PublisherName>Ezz Hassan</PublisherName>
		<Copyright>Copyright ©  2026</Copyright>
		<!-- Version comes from GIT TAGS via MinVer (tag = exact version; commits after a tag get a
		     prerelease label + height). Tag v1.2.3 for release 1.2.3, or v1.2.3-beta.1 for betas
		     (e.g. on develop). No manual <Version> here anymore. -->
		<MinVerTagPrefix>v</MinVerTagPrefix>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
		<PackageReference Include="MinVer" Version="7.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="EzzHelper" Version="2.0.3" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="WPF-UI" Version="4.3.0" />
		<PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- CsWin32 auto-discovers NativeMethods.txt only at the project root, so register our
         isolated copy explicitly. All raw Win32 declarations live in this one file. -->
		<AdditionalFiles Include="Win32APIs\NativeMethods\NativeMethods.txt" />
	</ItemGroup>

	<ItemGroup>
		<!-- Embedded WPF resources so windows/tray can load them via pack URI (ApplicationIcon only
         embeds app.ico into the exe header). -->
		<Resource Include="Assets\app.ico" />
		<Resource Include="Assets\app_image.png" />
		<Resource Include="Assets\github_dark.png" />
		<Resource Include="Assets\github_light.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="CSSWidgets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Animations\" />
	</ItemGroup>

</Project>
