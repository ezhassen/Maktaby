<UserControl
    x:Class="DesktopBoxesUI.Controls.ContainersControls.FolderPortalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DesktopBoxesUI.Converters"
    xmlns:ctrl="clr-namespace:DesktopBoxesUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DesktopBoxesUI.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="400"
    PreviewMouseDown="Control_PreviewMouseDown"
    PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
    PreviewMouseLeftButtonUp="FolderPortal_PreviewMouseLeftButtonUp"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:AdaptiveTileSizeConverter x:Key="TileWidth" />
        <conv:TileSizeToSizeConverter x:Key="TileSize" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource BoxBackground}">
        <!--  Placeholder when no folder selected / missing  -->
        <StackPanel
            x:Name="PlaceholderPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="13"
                Foreground="{DynamicResource BoxForeground}"
                Opacity="0.8"
                Text="No folder selected"
                TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFolderPath}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFolderMissing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    Margin="0,0,0,2"
                    FontSize="13"
                    Foreground="#FF6B6B"
                    Text="Folder not found"
                    TextAlignment="Center" />
                <TextBlock
                    MaxWidth="260"
                    Margin="0,0,0,8"
                    FontSize="11"
                    Foreground="{DynamicResource BoxForeground}"
                    Opacity="0.7"
                    Text="{Binding FolderPath}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="11"
                    Foreground="{DynamicResource BoxForeground}"
                    Opacity="0.6"
                    Text="It was deleted or moved."
                    TextAlignment="Center" />
            </StackPanel>
            <Button
                Margin="0,8,0,0"
                Padding="12,6"
                Click="SelectFolder_Click"
                Content="Select Folder"
                Cursor="Hand" />
        </StackPanel>

        <!--  Main content when folder selected  -->
        <Grid x:Name="ContentPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Navigation bar  -->
            <Border
                Grid.Row="0"
                Padding="4"
                Background="{DynamicResource BoxBackground}"
                BorderBrush="{DynamicResource BoxBorder}"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Button
                        x:Name="BackButton"
                        Grid.Column="0"
                        Padding="6,2"
                        Click="Back_Click"
                        Content="←"
                        ToolTip="Go up" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource BoxForeground}"
                        Opacity="0.7"
                        Text="{Binding CurrentFolderPath, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding CurrentFolderPath, FallbackValue=''}" />
                    <Button
                        x:Name="ViewToggleButton"
                        Grid.Column="2"
                        Padding="6,2"
                        Click="ToggleView_Click"
                        Cursor="Hand"
                        ToolTip="Toggle view">
                        <ui:SymbolIcon x:Name="ViewToggleIcon" Symbol="AppsListDetail24" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        Click="OpenFolder_Click"
                        Content="Open"
                        Cursor="Hand"
                        ToolTip="Open folder in Explorer" />
                    <Button
                        Grid.Column="4"
                        Margin="4,0,0,0"
                        Padding="6,2"
                        Click="SelectFolder_Click"
                        Content="Change..."
                        Cursor="Hand"
                        ToolTip="Change folder" />
                </Grid>
            </Border>

            <!--  Icons sorting bar  -->
            <Border
                x:Name="IconsSortBar"
                Grid.Row="1"
                Padding="4,2"
                Background="{DynamicResource BoxBackground}"
                BorderBrush="{DynamicResource BoxBorder}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource BoxForeground}"
                        Opacity="0.7"
                        Text="Sort:" />
                    <ComboBox
                        x:Name="IconsSortCombo"
                        Width="130"
                        FontSize="11"
                        SelectionChanged="IconsSortCombo_SelectionChanged">
                        <ComboBoxItem Content="Name" Tag="Name" />
                        <ComboBoxItem Content="Size" Tag="Size" />
                        <ComboBoxItem Content="Type" Tag="Type" />
                        <ComboBoxItem Content="Date modified" Tag="Date modified" />
                    </ComboBox>
                    <Button
                        x:Name="IconsSortDirectionButton"
                        Margin="6,0,0,0"
                        Padding="6,2"
                        Click="IconsSortDirection_Click"
                        ToolTip="Toggle ascending/descending">
                        <TextBlock
                            x:Name="IconsSortArrow"
                            FontSize="11"
                            Text="▲" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  Icons view  -->
            <ScrollViewer
                x:Name="IconsScroll"
                Grid.Row="2"
                Background="{DynamicResource BoxBackground}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    x:Name="IconsHost"
                    Background="{DynamicResource BoxBackground}"
                    ClipToBounds="False"
                    PreviewMouseLeftButtonDown="IconsHost_PreviewMouseLeftButtonDown">
                    <ItemsControl x:Name="IconsList" ItemsSource="{Binding FolderItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:FolderItemViewModel">
                                <Border
                                    x:Name="ItemBorder"
                                    Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TileWidth}, ConverterParameter=36}"
                                    Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TileWidth}, ConverterParameter=36}"
                                    Margin="2"
                                    ContextMenuOpening="ItemBorder_ContextMenuOpening"
                                    Cursor="Arrow"
                                    Focusable="True"
                                    GotFocus="ItemBorder_GotFocus"
                                    KeyDown="ItemBorder_KeyDown"
                                    MouseLeftButtonDown="ItemBorder_MouseLeftButtonDown"
                                    MouseLeftButtonUp="ItemBorder_MouseLeftButtonUp"
                                    MouseMove="ItemBorder_MouseMove"
                                    MouseRightButtonUp="ItemBorder_MouseRightButtonUp"
                                    PreviewMouseDown="ItemBorder_PreviewMouseDown"
                                    ToolTip="{Binding Path}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#407FB2FF" />
                                                    <Setter Property="BorderBrush" Value="#FF7FB2FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Vertical">
                                        <Image
                                            Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding Icon}" />
                                        <TextBlock
                                            MaxHeight="32"
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource BoxForeground}"
                                            Text="{Binding DisplayName}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!--  Details view - DataGrid (compact, virtualized, sorting)  -->
            <DataGrid
                x:Name="DetailsGrid"
                Grid.Row="2"
                AutoGenerateColumns="False"
                Background="{DynamicResource BoxBackground}"
                BorderBrush="{DynamicResource BoxBorder}"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                CanUserSortColumns="True"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                Foreground="{DynamicResource BoxForeground}"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                ItemsSource="{Binding FolderItems}"
                PreviewMouseLeftButtonDown="DetailsGrid_PreviewMouseLeftButtonDown"
                RowHeaderWidth="0"
                RowHeight="22"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Sorting="DetailsGrid_Sorting"
                VirtualizingPanel.IsContainerVirtualizable="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                Visibility="Collapsed">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource BoxHeaderBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource BoxHeaderForeground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                                    <Grid>
                                        <Border
                                            x:Name="HeaderBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                RecognizesAccessKey="True"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                        <Thumb
                                            x:Name="PART_HeaderGripper"
                                            Width="8"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            Cursor="SizeWE">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border Width="8" Background="Transparent">
                                                        <Rectangle
                                                            Width="1"
                                                            HorizontalAlignment="Center"
                                                            Fill="{DynamicResource BoxBorder}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#3F3F46" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#2D2D30" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#888888" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter Property="Foreground" Value="{DynamicResource BoxHeaderForeground}" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter Property="Foreground" Value="{DynamicResource BoxHeaderForeground}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="{x:Type ScrollViewer}">
                        <Setter Property="Background" Value="{DynamicResource BoxBackground}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource BoxForeground}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A" />
                                <Setter Property="BorderBrush" Value="#5A5A5A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#407FB2FF" />
                                <Setter Property="BorderBrush" Value="#FF7FB2FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#4A6EAF" />
                            </MultiTrigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF7FB2FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="11" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource BoxForeground}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Background" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="220"
                        CanUserSort="True"
                        Header="Name"
                        SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:FolderItemViewModel">
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding Icon}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding SizeText}"
                        CanUserSort="True"
                        ElementStyle="{StaticResource {x:Type TextBlock}}"
                        Header="Size"
                        SortMemberPath="FileSize" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding TypeName}"
                        CanUserSort="True"
                        Header="Type"
                        SortMemberPath="TypeName" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding ModifiedText}"
                        CanUserSort="True"
                        Header="Date modified"
                        SortMemberPath="ModifiedTime" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
