<UserControl
    x:Class="DesktopBoxesUI.Controls.BoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DesktopBoxesUI.ViewModels"
    d:DesignHeight="200"
    d:DesignWidth="240"
    AllowDrop="True"
    DragLeave="BoxControl_DragLeave"
    DragOver="BoxControl_DragOver"
    Drop="BoxControl_Drop"
    IsKeyboardFocusWithinChanged="BoxControl_IsKeyboardFocusWithinChanged"
    MouseLeftButtonUp="BoxControl_MouseLeftButtonUp"
    MouseMove="BoxControl_MouseMove"
    PreviewMouseLeftButtonDown="BoxControl_PreviewMouseLeftButtonDown"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer
        x:Name="Scroll"
        Background="{DynamicResource BoxBackground}"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ItemsHost" Background="{DynamicResource BoxBackground}">
            <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:BoxItemViewModel">
                        <Border
                            x:Name="ItemBorder"
                            Width="68"
                            Height="68"
                            Margin="2"
                            Padding="0"
                            ContextMenuOpening="ItemBorder_ContextMenuOpening"
                            Cursor="Arrow"
                            FocusVisualStyle="{x:Null}"
                            Focusable="True"
                            GotFocus="ItemBorder_GotFocus"
                            KeyDown="ItemBorder_KeyDown"
                            MouseLeftButtonDown="ItemBorder_MouseLeftButtonDown"
                            MouseLeftButtonUp="ItemBorder_MouseLeftButtonUp"
                            MouseMove="ItemBorder_MouseMove"
                            MouseRightButtonUp="ItemBorder_MouseRightButtonUp"
                            ToolTip="{Binding DisplayName}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!--  Constant thickness: selection must never change the tile size.  -->
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#407FB2FF" />
                                            <Setter Property="BorderBrush" Value="#FF7FB2FF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Vertical">
                                <Image
                                    Width="32"
                                    Height="32"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Icon}" />
                                <!--  Two-line clamp keeps every tile identical; the full name is in the ToolTip.  -->
                                <TextBlock
                                    MaxHeight="32"
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource BoxForeground}"
                                    Text="{Binding DisplayName}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox
                                    x:Name="RenameBox"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource BoxBackground}"
                                    BorderBrush="{DynamicResource BoxBorder}"
                                    BorderThickness="1"
                                    FontSize="11"
                                    Foreground="{DynamicResource BoxForeground}"
                                    KeyDown="RenameBox_KeyDown"
                                    LostFocus="RenameBox_LostFocus"
                                    Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Rectangle
                    x:Name="Marquee"
                    Fill="#407FB2FF"
                    IsHitTestVisible="False"
                    Stroke="#FF7FB2FF"
                    StrokeThickness="1"
                    Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </ScrollViewer>
</UserControl>
