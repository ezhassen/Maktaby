<ui:FluentWindow
    x:Class="DesktopBoxesUI.Views.WidgetsListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:DesktopBoxesUI.ViewModels"
    xmlns:models2="clr-namespace:DesktopBoxesUI.Core.Models;assembly=WPFShared"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DesktopBoxesUI.Views"
    Title="Widgets"
    Width="860"
    Height="560"
    MinWidth="760"
    MinHeight="400"
    Icon="/Assets/app.ico"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <!--
            Local button chrome for the per-item action buttons below. They live inside an
            ItemTemplate, where WPF-UI's own Button template misfires: its hover/pressed triggers
            copy Button DPs via {Binding RelativeSource=TemplatedParent} (NOT TemplateBinding),
            and a DataTemplate child's TemplatedParent is the hosting ContentPresenter — which has
            no PressedForeground/MouseOverBackground DPs (binding Error 40 on every hover/press).
            This template mirrors the same Button DPs with TemplateBinding (template-relative, so
            always the Button) and explicit state triggers. Base colors follow WPF-UI's style/API:
            Secondary + Transparent from style defaults, Primary from accent brushes.
        -->
        <ControlTemplate x:Key="GalleryRowButtonTemplate" TargetType="ui:Button">
            <Border
                x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                SnapsToDevicePixels="True">
                <StackPanel
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Orientation="Horizontal">
                    <ContentPresenter
                        x:Name="ControlIcon"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Icon}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                    <ContentPresenter
                        x:Name="Cp"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        RecognizesAccessKey="True"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Appearance" Value="Transparent">
                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                </Trigger>
                <Trigger Property="Appearance" Value="Primary">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentButtonBackground}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
                    <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForeground}" />
                    <Setter TargetName="ControlIcon" Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForeground}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Appearance" Value="Primary" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                    <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
                    <Setter TargetName="ControlIcon" Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}" />
                    <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
                    <Setter TargetName="ControlIcon" Property="TextElement.Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Appearance" Value="Primary" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPressed}" />
                    <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
                    <Setter TargetName="ControlIcon" Property="TextElement.Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
                    <Setter TargetName="ControlIcon" Property="TextElement.Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
                </Trigger>
                <DataTrigger Binding="{Binding Content, ElementName=ControlIcon}" Value="{x:Null}">
                    <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, ElementName=Cp}" Value="{x:Null}">
                    <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Widgets"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,12"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Available widgets" />
                <Border
                    Margin="12,0,0,0"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <TextBlock
                        x:Name="CountText"
                        FontSize="11"
                        Text="0 widgets" />
                </Border>
                <ui:Button
                    x:Name="NewButton"
                    Margin="16,0,0,0"
                    Appearance="Primary"
                    Click="New_Click"
                    Content="New Widget"
                    Icon="{ui:SymbolIcon Add24}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Click="Refresh_Click"
                    Content="Refresh"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WidgetsItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="240"
                                Margin="6"
                                Padding="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="90" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        CornerRadius="6">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailBitmap, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="Uniform">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="No preview">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ThumbnailPath}" Value="{x:Null}" />
                                                                    <Condition Binding="{Binding IsGenerating}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ui:ProgressRing
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    IsIndeterminate="{Binding IsGenerating}" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding LoadingStatus}" />
                                            </StackPanel>
                                            <StackPanel
                                                Margin="6"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Orientation="Horizontal">
                                                <Border
                                                    Padding="4,2"
                                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Kind}" />
                                                </Border>
                                                <Border
                                                    Margin="4,0,0,0"
                                                    Padding="4,2"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                    <TextBlock FontSize="10" Text="{Binding SourceLabel}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,8,0,2"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DisplayAuthor, FallbackValue='', TargetNullValue=''}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="OrangeRed"
                                        Text="{Binding LoadError}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel
                                        Grid.Row="4"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Padding="8,3"
                                            Appearance="Primary"
                                            Click="Place_Click"
                                            Content="Place"
                                            Tag="{Binding}"
                                            Template="{StaticResource GalleryRowButtonTemplate}"
                                            Visibility="{Binding DataContext.IsSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ui:Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanPlace}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>

                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="8,3"
                                            Appearance="Secondary"
                                            Click="Edit_Click"
                                            Icon="{ui:SymbolIcon Symbol=Edit20}"
                                            Tag="{Binding}"
                                            Template="{StaticResource GalleryRowButtonTemplate}"
                                            ToolTip="Edit">
                                            <ui:Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="{x:Static models2:WebWidgetSource.App}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static views:WidgetGalleryKind.Native}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="8,3"
                                            Appearance="Secondary"
                                            Click="Edit_Click"
                                            Icon="{ui:SymbolIcon Symbol=Folder20}"
                                            Tag="{Binding}"
                                            Template="{StaticResource GalleryRowButtonTemplate}"
                                            ToolTip="Open widget folder">
                                            <ui:Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static views:WidgetGalleryKind.Web}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="8,3"
                                            Appearance="Secondary"
                                            Click="Duplicate_Click"
                                            Icon="{ui:SymbolIcon Copy24}"
                                            Tag="{Binding}"
                                            Template="{StaticResource GalleryRowButtonTemplate}"
                                            ToolTip="Duplicate">
                                            <ui:Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static views:WidgetGalleryKind.Native}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="8,3"
                                            Appearance="Secondary"
                                            Click="RegenerateThumbnail_Click"
                                            Icon="{ui:SymbolIcon Symbol=ArrowSync20}"
                                            Tag="{Binding}"
                                            Template="{StaticResource GalleryRowButtonTemplate}"
                                            ToolTip="Regenerate Thumbnail">
                                            <ui:Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="6,3"
                                            Appearance="Transparent"
                                            Click="Delete_Click"
                                            Tag="{Binding}"
                                            Template="{StaticResource GalleryRowButtonTemplate}"
                                            ToolTip="Delete (user widgets only)">
                                            <ui:Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12,8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="User widgets stored in %LocalAppData%\DesktopBoxes\UserWidgets" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="CloseButton"
                        Appearance="Secondary"
                        Click="Close_Click"
                        Content="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:ContentDialogHost
            x:Name="RootContentDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3" />

    </Grid>
</ui:FluentWindow>
