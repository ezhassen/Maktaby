<Window
    x:Class="DesktopBoxesUI.Views.LoadingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Desktop Boxes"
    Width="340"
    Height="170"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/Assets/app.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Border
        Padding="20"
        Background="#2d2d30"
        BorderBrush="#3f3f46"
        BorderThickness="1"
        CornerRadius="8"
        Opacity="0.7">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:ProgressRing
                x:Name="Spinner"
                Width="36"
                Height="36"
                Margin="0,0,0,12"
                IsIndeterminate="True" />
            <TextBlock
                x:Name="MessageText"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="#e8e8e8"
                Text="Loading Desktop Boxes…" />
            <Button
                x:Name="CancelButton"
                Margin="0,12,0,0"
                Padding="24,4"
                HorizontalAlignment="Center"
                Background="#3f3f46"
                BorderBrush="#55555e"
                Click="CancelButton_Click"
                Content="Cancel"
                Foreground="#e8e8e8"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
