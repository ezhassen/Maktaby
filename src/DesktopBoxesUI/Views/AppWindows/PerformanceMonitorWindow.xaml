<ui:FluentWindow
    x:Class="DesktopBoxesUI.Views.PerformanceMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Performance Monitor"
    Width="760"
    Height="800"
    MinWidth="640"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Performance Monitor"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Summary  -->
        <Border
            Grid.Row="1"
            Margin="12,6,12,6"
            Padding="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="APP PROCESS (main)"
                        ToolTip="Working set — same metric as Task Manager's Processes-tab Memory column." />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding TotalMemoryMB, StringFormat={}{0} MB}"
                            ToolTip="Working set (resident RAM), matches Task Manager." />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding TotalCpu, StringFormat={}{0:0.0}% CPU}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding TotalIo}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding ManagedMemoryMB, StringFormat={}Managed heap: {0} MB}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding TotalPrivateMB, StringFormat={}Private (commit): {0} MB}"
                        ToolTip="Private bytes (committed virtual). Always higher than working set — not what Task Manager shows." />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding GroupMemoryMB, StringFormat={}Group total: {0} MB}"
                        ToolTip="Main + WebView2 working sets — matches Task Manager's collapsed group row." />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="WEBVIEW2" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding WebView2MemoryMB, StringFormat={}{0} MB}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding WebView2Cpu, StringFormat={}{0:0.0}% CPU}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding WebView2ProcessCount, StringFormat={}{0} processes}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding GroupCpu, StringFormat={}Group CPU: {0:0.0}%}"
                        ToolTip="Main + WebView2 CPU — matches Task Manager's collapsed group row." />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="IdleBadge"
                        Padding="8,4"
                        CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#D0F0D0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIdleMode}" Value="True">
                                        <Setter Property="Background" Value="#FFE8A0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Active" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIdleMode}" Value="True">
                                            <Setter Property="Text" Value="Idle" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Idle suspends WebView"
                        TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  WebView2 per-process breakdown (own row; collapses to zero height when empty)  -->
        <Border
            Grid.Row="2"
            Margin="12,0,12,4"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWebView2Processes}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="8,2"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8,8,0,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="WebView2Header_Toggle"
                    ToolTip="Click to collapse / expand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsWebView2Expanded, Mode=TwoWay}"
                            Style="{StaticResource ToggleButtonCollapsable}"
                            ToolTip="Collapse / expand" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="WebView2 processes" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="working set per msedgewebview2.exe · Browser = top-level, Child = renderer/GPU/utility" />
                    </Grid>
                </Border>
                <DataGrid
                    Grid.Row="1"
                    MaxHeight="120"
                    Margin="4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    ColumnHeaderHeight="24"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding WebView2Processes}"
                    RowHeaderWidth="0"
                    RowHeight="22"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsWebView2Expanded, Converter={StaticResource BoolToVis}}">
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Pid}"
                            Header="PID" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Kind}"
                            Header="Type" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding MemoryMB, StringFormat={}{0} MB}"
                            Header="Memory" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Cpu, StringFormat={}{0:0.0}%}"
                            Header="CPU" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!--  Per-window list  -->
        <Border
            Grid.Row="3"
            Margin="12,0,12,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="8,4"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Windows / Widgets" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                Padding="8,2"
                                Appearance="Secondary"
                                Click="SuspendIdle_Click"
                                Content="Suspend Idle"
                                FontSize="11"
                                ToolTip="Force suspend all hidden widgets" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Padding="8,2"
                                Appearance="Secondary"
                                Click="ResumeAll_Click"
                                Content="Resume All"
                                FontSize="11" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding LayoutAnchorStatus}"
                            TextWrapping="Wrap"
                            ToolTip="Rescale baseline vs live primary area: if they disagree with no recent pass, scheduling (not math) is the suspect." />
                    </Grid>
                </Border>
                <DataGrid
                    x:Name="WindowsGrid"
                    Grid.Row="1"
                    Margin="4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    ColumnHeaderHeight="24"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Items}"
                    PreviewMouseRightButtonDown="WindowsGrid_PreviewMouseRightButtonDown"
                    RowHeaderWidth="0"
                    RowHeight="22"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="HideSelected_Click" Header="Hide" />
                            <MenuItem Click="ShowSelected_Click" Header="Show" />
                            <Separator />
                            <MenuItem Click="SuspendSelected_Click" Header="Suspend" />
                            <MenuItem Click="ResumeSelected_Click" Header="Resume" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Name}"
                            Header="Name" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Type}"
                            Header="Type" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding IsVisible}"
                            Header="Visible" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Status}"
                            Header="Status" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding ModelBounds}"
                            Header="Model Bounds">
                            <DataGridTextColumn.CellStyle>
                                <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoundsMismatch}" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding AppliedBounds}"
                            Header="Applied Bounds">
                            <DataGridTextColumn.CellStyle>
                                <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoundsMismatch}" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="Disabled — enable the app to show windows">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAppDisabled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Margin="12,0,12,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="8,4"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8,8,0,0">
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Live Wallpaper" />
                        <TextBlock
                            Margin="8,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding LiveWallpaperSummary}" />
                    </Grid>
                </Border>
                <DataGrid
                    x:Name="LiveWallpaperGrid"
                    Grid.Row="1"
                    MaxHeight="150"
                    Margin="4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    ColumnHeaderHeight="24"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding LiveWallpaperMonitors}"
                    RowHeaderWidth="0"
                    RowHeight="22"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Device}"
                            Header="Monitor" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding Bounds}"
                            Header="Bounds" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding File}"
                            Header="File" />
                        <DataGridTextColumn
                            Width="60"
                            Binding="{Binding Renderer}"
                            Header="Type" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding WebProcess}"
                            Header="Web PID" />

                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Preloaded}"
                            Header="Preloaded" />

                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Status}"
                            Header="Status" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding PauseReason}"
                            Header="Paused Reason" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="Live wallpaper is disabled">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveWallpaperDisabled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border
            Grid.Row="5"
            Padding="8,4"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                FontSize="10"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="Idle: when Hide All / minimized / no visible widget, WebView2 is suspended via TrySuspendAsync to cut CPU. Widgets use visibility-aware JS (document.hidden check) and CSS containment. See WebWidgets style.css data-theme handling."
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</ui:FluentWindow>
