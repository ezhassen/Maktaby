<ui:FluentWindow
    x:Class="DesktopBoxesUI.Views.WidgetDataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Widget Editor"
    Width="1100"
    Height="700"
    MinWidth="900"
    MinHeight="500"
    Icon="/Assets/app.ico"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Widget Editor"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Manifest fields  -->
        <Border
            Grid.Row="1"
            Margin="12,8,12,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="NAME (FOLDER)" />
                    <ui:TextBox
                        x:Name="NameBox"
                        Margin="0,4,0,8"
                        PlaceholderText="MyWidget" />
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="AUTHOR" />
                    <ui:TextBox
                        x:Name="AuthorBox"
                        Margin="0,4,0,0"
                        PlaceholderText="Author" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="DESCRIPTION" />
                    <ui:TextBox
                        x:Name="DescBox"
                        Margin="0,4,0,8"
                        PlaceholderText="Description" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="WIDTH" />
                            <ui:TextBox
                                x:Name="WidthBox"
                                Margin="0,4,0,0"
                                PlaceholderText="300" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="HEIGHT" />
                            <ui:TextBox
                                x:Name="HeightBox"
                                Margin="0,4,0,0"
                                PlaceholderText="220" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom">
                            <CheckBox
                                x:Name="ResizableBox"
                                Content="Resizable"
                                IsChecked="True" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom">
                            <CheckBox
                                x:Name="NetworkBox"
                                Content="Allow network"
                                ToolTip="Allow fetch/XHR/WebSocket" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom">
                            <CheckBox
                                x:Name="ThemeSwitchBox"
                                Checked="ThemeSwitchBox_Changed"
                                Content="Can switch theme"
                                Indeterminate="ThemeSwitchBox_Changed"
                                IsThreeState="True"
                                ToolTip="Widget adapts to Light/Dark app theme via data-theme (indeterminate = inherited / null)"
                                Unchecked="ThemeSwitchBox_Changed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Bottom">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="VERSION" />
                    <ui:TextBox
                        x:Name="VersionBox"
                        Width="100"
                        Margin="0,4,0,0"
                        PlaceholderText="1.0.0" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Editors + Preview  -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0">
                <TabItem Header="HTML">
                    <Grid>
                        <TextBox
                            x:Name="HtmlBox"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            HorizontalScrollBarVisibility="Auto"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
                <TabItem Header="CSS">
                    <Grid>
                        <TextBox
                            x:Name="CssBox"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            HorizontalScrollBarVisibility="Auto"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
                <TabItem Header="JavaScript">
                    <Grid>
                        <TextBox
                            x:Name="JsBox"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            HorizontalScrollBarVisibility="Auto"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Center"
                Background="Transparent" />

            <Border
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Padding="8"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8,8,0,0">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="PREVIEW" />
                            <ui:Button
                                HorizontalAlignment="Right"
                                Appearance="Transparent"
                                Click="PreviewRefresh_Click"
                                Content="Refresh"
                                Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Margin="8"
                        Background="White"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ContentControl x:Name="PreviewHost" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="12,8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="User widgets stored in %LocalAppData%\DesktopBoxes\UserWidgets" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Secondary"
                        Click="Cancel_Click"
                        Content="Cancel" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Click="Save_Click"
                        Content="Save" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:ContentDialogHost
            x:Name="RootContentDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
