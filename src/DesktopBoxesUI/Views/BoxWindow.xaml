<Window
    x:Class="DesktopBoxesUI.Views.BoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DesktopBoxesUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="160"
    MinHeight="120"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStyle="None"
    mc:Ignorable="d">
    <Border
        x:Name="RootBorder"
        Background="#2d2d30"
        BorderBrush="#3f3f46"
        BorderThickness="1"
        CornerRadius="8">
        <DockPanel LastChildFill="True">
            <Border
                x:Name="HeaderBorder"
                Padding="6,4"
                Background="#3f3f46"
                CornerRadius="8,8,0,0"
                DockPanel.Dock="Top">
                <Grid ColumnDefinitions="auto, *">
                    <Button
                        x:Name="MenuButton"
                        Grid.Column="0"
                        Width="26"
                        Height="22"
                        Margin="0,0,6,0"
                        Click="MenuButton_Click"
                        Content="&#9776;"
                        Cursor="Arrow"
                        DockPanel.Dock="Left">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="BoxMenu">
                                <MenuItem Click="MenuRename_Click" Header="Rename" />
                                <MenuItem Click="MenuNew_Click" Header="New Box" />
                                <MenuItem Click="MenuDelete_Click" Header="Delete Box" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Grid
                        x:Name="TitleArea"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="TitleArea_MouseLeftButtonDown"
                        MouseMove="TitleArea_MouseMove"
                        MouseLeftButtonUp="TitleArea_MouseLeftButtonUp">
                        <TextBlock
                            x:Name="TitleText"
                            MinWidth="120"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Foreground="White"
                            MouseLeftButtonDown="TitleText_MouseLeftButtonDown"
                            Text="{Binding Name}"
                            TextAlignment="Center" />
                        <TextBox
                            x:Name="TitleEdit"
                            MinWidth="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            KeyDown="TitleEdit_KeyDown"
                            LostFocus="TitleEdit_LostFocus"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <Grid>
                <controls:BoxControl x:Name="BoxContent" />
                <!--<ResizeGrip
                    x:Name="ResizeGrip"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                    MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                    MouseMove="ResizeGrip_MouseMove" />-->
            </Grid>
        </DockPanel>
    </Border>
</Window>
