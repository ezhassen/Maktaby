<Window x:Class="DesktopBoxesUI.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Desktop Boxes"
        Width="320"
        Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Border
        Background="#2d2d30"
        BorderBrush="#3f3f46"
        BorderThickness="1"
        CornerRadius="8"
        Padding="20">
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <ui:ProgressRing
                IsIndeterminate="True"
                Width="36"
                Height="36"
                Margin="0,0,0,12" />
            <TextBlock
                Text="Loading Desktop Boxes…"
                Foreground="#e8e8e8"
                FontSize="14"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
