<ui:FluentWindow
    x:Class="DesktopBoxesUI.Views.Dialogs.ColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Pick color"
    Width="380"
    Height="420"
    MinWidth="340"
    MinHeight="380"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Pick color"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Preview + Hex -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush x:Name="PreviewBrush" Color="Transparent" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Hex" />
                    <ui:TextBox x:Name="HexBox" Margin="0,4,0,0" TextChanged="HexBox_TextChanged" />
                    <TextBlock x:Name="ValidationText" Margin="0,2,0,0" FontSize="11" Foreground="#F44336" Visibility="Collapsed" Text="Invalid hex" />
                </StackPanel>
            </Grid>

            <!-- Sliders -->
            <StackPanel Grid.Row="1">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="R" />
                    <Slider x:Name="RSlider" Grid.Column="1" Maximum="255" Minimum="0" ValueChanged="Slider_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=RSlider, StringFormat={}{0:0}}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="G" />
                    <Slider x:Name="GSlider" Grid.Column="1" Maximum="255" Minimum="0" ValueChanged="Slider_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=GSlider, StringFormat={}{0:0}}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="B" />
                    <Slider x:Name="BSlider" Grid.Column="1" Maximum="255" Minimum="0" ValueChanged="Slider_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=BSlider, StringFormat={}{0:0}}" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="A" />
                    <Slider x:Name="ASlider" Grid.Column="1" Maximum="255" Minimum="0" Value="255" ValueChanged="Slider_ValueChanged" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Value, ElementName=ASlider, StringFormat={}{0:0}}" />
                </Grid>
            </StackPanel>

            <!-- Standard palette -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Standard" />
                <WrapPanel x:Name="StandardPanel" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Recent -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Recent" />
                <WrapPanel x:Name="RecentPanel" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="16,12"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    MinWidth="90"
                    Appearance="Secondary"
                    Click="Cancel_Click"
                    Content="Cancel"
                    IsCancel="True" />
                <ui:Button
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    Click="Ok_Click"
                    Content="OK"
                    IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
