<ui:FluentWindow
    x:Class="DesktopBoxesUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DesktopBoxesUI.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings"
    Width="460"
    Height="600"
    MinWidth="420"
    MinHeight="480"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:HexValidToBrushConverter x:Key="HexValidToBrush" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Settings"
            ShowMaximize="False"
            ShowMinimize="False" />

        <ScrollViewer
            Grid.Row="1"
            Padding="16,8,16,8"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Margin="0,0,0,12" Header="Preview">
                    <Border
                        x:Name="PreviewBox"
                        Width="320"
                        Height="160"
                        CornerRadius="8"
                        Padding="0">
                        <DockPanel LastChildFill="True">
                            <Border
                                x:Name="PreviewHeader"
                                Height="24"
                                CornerRadius="8,8,0,0"
                                DockPanel.Dock="Top">
                                <TextBlock
                                    x:Name="PreviewTitle"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="Box Title" />
                            </Border>
                            <WrapPanel
                                x:Name="PreviewBody"
                                Margin="8"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <StackPanel Width="64" Margin="4">
                                    <Rectangle
                                        x:Name="PreviewIcon1"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        Fill="#888888" />
                                    <TextBlock
                                        x:Name="PreviewItem1"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="Item"
                                        TextAlignment="Center" />
                                </StackPanel>
                                <StackPanel Width="64" Margin="4">
                                    <Rectangle
                                        x:Name="PreviewIcon2"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        Fill="#888888" />
                                    <TextBlock
                                        x:Name="PreviewItem2"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="Item"
                                        TextAlignment="Center" />
                                </StackPanel>
                                <StackPanel Width="64" Margin="4">
                                    <Rectangle
                                        x:Name="PreviewIcon3"
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Center"
                                        Fill="#888888" />
                                    <TextBlock
                                        x:Name="PreviewItem3"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Text="Item"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </GroupBox>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock
                        FontWeight="Bold"
                        Text="App theme" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="#999999"
                        Text="System follows the Windows light/dark setting." />
                    <ComboBox
                        Width="200"
                        ItemsSource="{Binding AppThemeOptions}"
                        SelectedItem="{Binding SelectedThemeOption, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock
                        FontWeight="Bold"
                        Text="Default box transparency" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="#999999"
                        Text="0 = opaque .. 1 = transparent." />
                    <Slider
                        Width="320"
                        HorizontalAlignment="Left"
                        IsSnapToTickEnabled="True"
                        Maximum="1"
                        Minimum="0"
                        TickFrequency="0.05"
                        Value="{Binding DefaultBoxTransparency}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock
                        FontWeight="Bold"
                        Text="Default box theme" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="#999999"
                        Text="App = follow the app theme above." />
                    <ComboBox
                        Width="200"
                        ItemsSource="{Binding BoxThemeOptions}"
                        SelectedItem="{Binding DefaultBoxThemeOption, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <GroupBox
                    Margin="0,0,0,12"
                    Header="Default box colors (override theme when set)">
                    <StackPanel Margin="8">
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="Background" />
                            <ui:TextBox
                                Width="120"
                                Text="{Binding DefaultBoxBackColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Margin="8,0,0,0"
                                Stroke="{Binding DefaultBoxBackColor, Converter={StaticResource HexValidToBrush}}"
                                StrokeThickness="1"
                                Fill="{Binding DefaultBoxBackColor, Converter={StaticResource HexToBrush}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="Foreground" />
                            <ui:TextBox
                                Width="120"
                                Text="{Binding DefaultBoxForeColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Margin="8,0,0,0"
                                Stroke="{Binding DefaultBoxForeColor, Converter={StaticResource HexValidToBrush}}"
                                StrokeThickness="1"
                                Fill="{Binding DefaultBoxForeColor, Converter={StaticResource HexToBrush}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="Border" />
                            <ui:TextBox
                                Width="120"
                                Text="{Binding DefaultBoxBorderColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Margin="8,0,0,0"
                                Stroke="{Binding DefaultBoxBorderColor, Converter={StaticResource HexValidToBrush}}"
                                StrokeThickness="1"
                                Fill="{Binding DefaultBoxBorderColor, Converter={StaticResource HexToBrush}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="Title bar back" />
                            <ui:TextBox
                                Width="120"
                                Text="{Binding DefaultBoxTitleBarBackColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Margin="8,0,0,0"
                                Stroke="{Binding DefaultBoxTitleBarBackColor, Converter={StaticResource HexValidToBrush}}"
                                StrokeThickness="1"
                                Fill="{Binding DefaultBoxTitleBarBackColor, Converter={StaticResource HexToBrush}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="Title bar fore" />
                            <ui:TextBox
                                Width="120"
                                Text="{Binding DefaultBoxTitleBarForeColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Margin="8,0,0,0"
                                Stroke="{Binding DefaultBoxTitleBarForeColor, Converter={StaticResource HexValidToBrush}}"
                                StrokeThickness="1"
                                Fill="{Binding DefaultBoxTitleBarForeColor, Converter={StaticResource HexToBrush}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock
                                Width="120"
                                VerticalAlignment="Center"
                                Text="Border thickness" />
                            <ui:TextBox
                                Width="120"
                                Text="{Binding DefaultBoxBorderThickness, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox
                            Margin="0,4,0,0"
                            Content="Title bar uses box colors"
                            IsChecked="{Binding DefaultBoxTitleBarColorsSameAsBox}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="16,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Width="80"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="Cancel_Click"
                Content="Cancel" />
            <ui:Button
                Width="80"
                Appearance="Primary"
                Click="Save_Click"
                Content="Save" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
