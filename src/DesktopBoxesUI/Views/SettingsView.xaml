<ui:FluentWindow
    x:Class="DesktopBoxesUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DesktopBoxesUI.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings"
    Width="720"
    Height="640"
    MinWidth="560"
    MinHeight="480"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:HexValidToBrushConverter x:Key="HexValidToBrush" />

        <!--  Borderless, rounded reset-to-default button. Tooltip "Reset".  -->
        <Style
            x:Key="ResetButton"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="ToolTip" Value="Reset to default" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Settings"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <ListBox
                    x:Name="CategoryList"
                    Background="Transparent"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="CategoryList_PreviewMouseDown"
                    SelectedIndex="0">
                    <ListBoxItem Content="Preview" Tag="SectionPreview" />
                    <ListBoxItem Content="Appearance" Tag="SectionAppearance" />
                    <ListBoxItem Content="Boxes" Tag="SectionBoxes" />
                    <ListBoxItem Content="General" Tag="SectionGeneral" />
                    <ListBoxItem Content="Snapshot" Tag="SectionSnapshot" />
                </ListBox>
            </Border>

            <ScrollViewer
                x:Name="ContentScroll"
                Grid.Column="1"
                Padding="16,8,16,8"
                ScrollChanged="ContentScroll_ScrollChanged"
                SizeChanged="ContentScroll_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox
                        x:Name="SectionPreview"
                        Margin="0,0,0,12"
                        Header="Preview">
                        <Border
                            x:Name="PreviewDesktop"
                            Padding="16"
                            CornerRadius="8">
                            <Border
                                x:Name="PreviewBox"
                                Width="320"
                                Height="160"
                                Padding="0"
                                CornerRadius="8">
                                <DockPanel LastChildFill="True">
                                    <Border
                                        x:Name="PreviewHeader"
                                        Height="24"
                                        CornerRadius="8,8,0,0"
                                        DockPanel.Dock="Top">
                                        <TextBlock
                                            x:Name="PreviewTitle"
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="Box Title" />
                                    </Border>
                                    <WrapPanel
                                        x:Name="PreviewBody"
                                        Margin="8"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal" />
                                </DockPanel>
                            </Border>
                        </Border>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionAppearance"
                        Margin="0,0,0,12"
                        Header="Appearance">
                        <StackPanel Margin="8">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontWeight="Bold" Text="App theme" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="System follows the Windows light/dark setting." />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding AppThemeOptions}"
                                        SelectedItem="{Binding SelectedThemeOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="SelectedThemeOption"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontWeight="Bold" Text="Default box transparency" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="0 = opaque .. 1 = transparent." />
                                <StackPanel Orientation="Horizontal">
                                    <Slider
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Maximum="1"
                                        Minimum="0"
                                        TickFrequency="0.05"
                                        Value="{Binding DefaultBoxTransparencyValue}" />
                                    <TextBlock
                                        Width="48"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding DefaultBoxTransparencyValue, StringFormat={}{0:0.00}}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="DefaultBoxTransparencyValue"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionBoxes"
                        Margin="0,0,0,12"
                        Header="Boxes">
                        <StackPanel Margin="8">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontWeight="Bold" Text="Default box theme" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="App = follow the app theme above." />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding BoxThemeOptions}"
                                        SelectedItem="{Binding DefaultBoxThemeOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="DefaultBoxThemeOption"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <GroupBox Margin="0,4,0,8" Header="Default box colors (override theme when set)">
                                <StackPanel Margin="8">
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="Background" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxBackColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxBackColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxBackColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxBackColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="Foreground" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxForeColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxForeColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxForeColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxForeColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="Border" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxBorderColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxBorderColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxBorderColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxBorderColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="Title bar back" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxTitleBarBackColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxTitleBarBackColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxTitleBarBackColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxTitleBarBackColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="Title bar fore" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxTitleBarForeColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxTitleBarForeColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxTitleBarForeColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxTitleBarForeColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="Border thickness" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxBorderThickness, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxBorderThickness"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <CheckBox
                                            Margin="0,4,0,0"
                                            Content="Title bar uses box colors"
                                            IsChecked="{Binding DefaultBoxTitleBarColorsSameAsBox}" />
                                        <ui:Button
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxTitleBarColorsSameAsBox"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionGeneral"
                        Margin="0,0,0,12"
                        Header="General">
                        <StackPanel Margin="8">
                            <CheckBox Content="Launch DesktopBoxes on Windows startup" IsChecked="{Binding LaunchOnStartup}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="#999999"
                                Text="Adds (or removes) the app from your personal Run key so it starts when you sign in." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionSnapshot"
                        Margin="0,0,0,12"
                        Header="Snapshot">
                        <StackPanel Margin="8">
                            <TextBlock
                                FontSize="11"
                                Foreground="#999999"
                                Text="Back up the current layout, restore it from a backup file, or permanently delete everything." />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Click="Backup_Click"
                                    Content="Backup" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Click="Restore_Click"
                                    Content="Restore" />
                                <ui:Button
                                    Appearance="Danger"
                                    Click="ResetSnapshot_Click"
                                    Content="Reset" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="11"
                                Foreground="#C0392B"
                                Text="Reset is destructive: it deletes all boxes and rebuilds from scratch. This cannot be undone." />
                        </StackPanel>
                    </GroupBox>

                    <!--  Spacer: sized in code-behind so the last section can scroll up to the top.  -->
                    <Border x:Name="BottomSpacer" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="16,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Width="80"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="Cancel_Click"
                Content="Cancel" />
            <ui:Button
                Width="80"
                Appearance="Primary"
                Click="Save_Click"
                Content="Save" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
