<ui:FluentWindow
    x:Class="DesktopBoxesUI.Views.WidgetsListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Widgets"
    Width="860"
    Height="560"
    MinWidth="760"
    MinHeight="400"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Widgets" Grid.Row="0" ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Available widgets" />
                <Border
                    Margin="12,0,0,0"
                    Padding="6,2"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <TextBlock x:Name="CountText" FontSize="11" Text="0 widgets" />
                </Border>
                <ui:Button
                    x:Name="NewButton"
                    Margin="16,0,0,0"
                    Appearance="Primary"
                    Click="New_Click"
                    Content="New Widget"
                    Icon="{ui:SymbolIcon Add24}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Click="Refresh_Click"
                    Content="Refresh"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WidgetsItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="240"
                                Margin="6"
                                Padding="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="90" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        CornerRadius="6">
                                        <Grid>
                                            <Image
                                                Source="{Binding ThumbnailPath, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                                Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="No preview">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ThumbnailPath}" Value="{x:Null}" />
                                                                    <Condition Binding="{Binding IsGenerating}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ui:ProgressRing
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    IsIndeterminate="True" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="Generating thumbnail..." />
                                            </StackPanel>
                                            <Border
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="6"
                                                Padding="4,2"
                                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Source}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,8,0,2"
                                        FontWeight="SemiBold"
                                        Text="{Binding Manifest.Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Manifest.Author, FallbackValue='', TargetNullValue=''}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal">
                                        <ui:Button
                                            Padding="8,3"
                                            Appearance="Primary"
                                            Click="Place_Click"
                                            Content="Place"
                                            Tag="{Binding}"
                                            Visibility="{Binding DataContext.IsSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="8,3"
                                            Appearance="Secondary"
                                            Click="Edit_Click"
                                            Content="Edit"
                                            Tag="{Binding}" />
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="6,3"
                                            Appearance="Transparent"
                                            Click="Delete_Click"
                                            Tag="{Binding}"
                                            ToolTip="Delete (user widgets only)">
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12,8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="User widgets stored in %LocalAppData%\DesktopBoxes\UserWidgets" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="SelectButton"
                        MinWidth="100"
                        Appearance="Primary"
                        Click="Select_Click"
                        Content="Select"
                        Visibility="Collapsed" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        Click="Close_Click"
                        Content="Close" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
