<Window
    x:Class="DesktopBoxesUI.Views.Containers.CssWidgetChromeOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None">
    <Border
        x:Name="RootBorder"
        Background="Transparent"
        BorderBrush="{DynamicResource BoxBorder}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  TitleBar — always visible when overlay is shown; overlay visibility itself is controlled by ShowChromeOnHover  -->
            <Border
                x:Name="HeaderBorder"
                Grid.Row="0"
                Height="28"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="TitleArea"
                        Grid.Column="0"
                        Background="Transparent">
                        <TextBlock
                            x:Name="TitleText"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Widget"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <ui:Button
                        x:Name="ToggleLocked"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        Padding="0"
                        Appearance="Transparent"
                        Click="ToggleLocked_Click"
                        Icon="{StaticResource ItemIcon_Locked}"
                        ToolTip="Toggle Locked" />

                    <ui:Button
                        x:Name="MenuButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        Click="MenuButton_Click"
                        ToolTip="Options">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" />
                    </ui:Button>
                </Grid>
            </Border>
            <!--  Spacer — transparent, hit-test transparent so WebView below receives clicks  -->
            <Border Grid.Row="1" Background="Transparent" />
        </Grid>
    </Border>
</Window>
