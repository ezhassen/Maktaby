<containers:WidgetWindow
    x:Class="DesktopBoxesUI.Views.Containers.BoxContainerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:containers="clr-namespace:DesktopBoxesUI.Views.Containers"
    xmlns:containersControls="clr-namespace:DesktopBoxesUI.Controls.ContainersControls"
    xmlns:controls="clr-namespace:DesktopBoxesUI.Controls"
    xmlns:conv="clr-namespace:DesktopBoxesUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DesktopBoxesUI.ViewModels"
    MinWidth="160"
    MinHeight="120"
    AllowsTransparency="True"
    Background="Transparent"
    Deactivated="Window_Deactivated"
    IsKeyboardFocusWithinChanged="Window_IsKeyboardFocusWithinChanged"
    MouseEnter="Window_MouseEnter"
    MouseLeave="Window_MouseLeave"
    MouseLeftButtonUp="TitleArea_MouseLeftButtonUp"
    MouseMove="TitleArea_MouseMove"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewMouseDown="Window_PreviewMouseDown"
    PreviewMouseLeftButtonUp="Tab_PreviewMouseLeftButtonUp"
    PreviewMouseMove="Tab_PreviewMouseMove"
    ResizeMode="CanResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    WindowStyle="None"
    mc:Ignorable="d">
    <containers:WidgetWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:TabSelectedConverter x:Key="TabSelectedConverter" />

        <!--
            A tab button: unselected = borderless text on the box surface; selected = filled with the
            box background in a Chrome-style tab shape (rounded top, sides that flare OUT into little
            feet at the bottom that hug the strip) and no bottom border so it reads as connected.
        -->
        <ControlTemplate x:Key="TabButtonTemplate" TargetType="Button">
            <Grid Margin="3,1">
                <Path
                    x:Name="Fill"
                    Data="M0,30 L0,10 Q0,0 10,0 L90,0 Q100,0 100,10 L100,30 L0,30 Z"
                    Fill="{TemplateBinding Background}"
                    Stretch="Fill" />
                <!--  Data="M0,10 Q0,0 10,0 L90,0 Q100,0 100,10 C100,16 128,26 128,34 Q128,40 118,40 L-18,40 Q-28,40 -28,34 C-28,26 0,16 0,10 Z"  -->
                <Path
                    x:Name="Outline"
                    Data="M0,30 L0,10 Q0,0 10,0 L90,0 Q100,0 100,10 L100,30"
                    Stretch="Fill"
                    Stroke="{TemplateBinding BorderBrush}"
                    StrokeThickness="1" />
                <ContentPresenter
                    Margin="15,6,15,12"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource TabButtonTemplate}" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A6FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource TabSelectedConverter}">
                            <Binding Path="." />
                            <Binding Path="DataContext.BoxContainerVm.SelectedBox" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource BoxBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource BoxForeground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}" />
                    <Setter Property="BorderThickness" Value="1,1,1,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </containers:WidgetWindow.Resources>
    <Border
        x:Name="RootBorder"
        Background="#2d2d30"
        BorderBrush="#3f3f46"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <DockPanel LastChildFill="True">
                <Border
                    x:Name="HeaderBorder"
                    Padding="6,4"
                    Background="#3f3f46"
                    CornerRadius="8,8,0,0"
                    DockPanel.Dock="Top">
                    <Grid x:Name="HeaderContent" ColumnDefinitions="auto, *, auto">
                        <Button
                            x:Name="MenuButton"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="MenuButton_Click"
                            Cursor="Arrow"
                            DockPanel.Dock="Left"
                            Style="{StaticResource BorderlesButtonStyle}"
                            ToolTip="Menu">
                            <ui:SymbolIcon Symbol="Navigation24" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="BoxMenu">
                                    <!--  Not implemented yet  -->
                                    <MenuItem
                                        Click="MenuHide_Click"
                                        Header="Hide"
                                        Icon="{StaticResource ItemIcon_HideBoxe}"
                                        Visibility="Collapsed" />
                                    <!--  Not implemented yet  -->
                                    <MenuItem
                                        Click="MenuLock_Click"
                                        Header="Lock / Unlock"
                                        Icon="{StaticResource ItemIcon_Locked}"
                                        Visibility="Collapsed" />
                                    <!--<Separator />-->
                                    <MenuItem
                                        x:Name="MenuAddTab"
                                        Click="AddTab_Click"
                                        Header="Add Tab"
                                        Icon="{StaticResource ItemIcon_NewBox}" />
                                    <MenuItem
                                        x:Name="MenuAddFolderPortal"
                                        Click="AddFolderPortal_Click"
                                        Header="Add Folder Portal"
                                        Icon="{StaticResource ItemIcon_FolderPortal}" />
                                    <MenuItem
                                        x:Name="MenuRemoveTab"
                                        Click="RemoveTab_Click"
                                        Foreground="OrangeRed"
                                        Header="Remove Tab"
                                        Icon="{StaticResource ItemIcon_Remove}" />
                                    <Separator />
                                    <MenuItem x:Name="MenuBoxType" Header="Box Type">
                                        <MenuItem
                                            x:Name="MenuBoxTypeDesktop"
                                            Click="MenuBoxType_Click"
                                            Header="Desktop Items"
                                            Icon="{StaticResource ItemIcon_NewBox}"
                                            IsCheckable="True"
                                            Tag="DesktopItems" />
                                        <MenuItem
                                            x:Name="MenuBoxTypeFolder"
                                            Click="MenuBoxType_Click"
                                            Header="Folder Portal"
                                            Icon="{StaticResource ItemIcon_FolderPortal}"
                                            IsCheckable="True"
                                            Tag="FolderPortal" />
                                    </MenuItem>
                                    <MenuItem x:Name="MenuFolderView" Header="Folder View">
                                        <MenuItem
                                            x:Name="MenuFolderViewIcons"
                                            Click="MenuFolderView_Click"
                                            Header="Icons"
                                            IsCheckable="True"
                                            Tag="Icons" />
                                        <MenuItem
                                            x:Name="MenuFolderViewDetails"
                                            Click="MenuFolderView_Click"
                                            Header="Details"
                                            IsCheckable="True"
                                            Tag="Details" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="MenuRollDir" Header="Roll Direction">
                                        <MenuItem
                                            x:Name="MenuSetRollDirAuto"
                                            Click="MenuSetRollDir_Click"
                                            Header="Auto (snap)"
                                            Icon="{StaticResource ItemIcon_Roll_Auto}"
                                            IsCheckable="True"
                                            Tag="Auto" />
                                        <Separator />
                                        <MenuItem
                                            x:Name="MenuSetRollDirTop"
                                            Click="MenuSetRollDir_Click"
                                            Header="Top"
                                            Icon="{StaticResource ItemIcon_Roll_Up}"
                                            IsCheckable="True"
                                            Tag="Top" />
                                        <MenuItem
                                            x:Name="MenuSetRollDirBottom"
                                            Click="MenuSetRollDir_Click"
                                            Header="Bottom"
                                            Icon="{StaticResource ItemIcon_Roll_Down}"
                                            IsCheckable="True"
                                            Tag="Bottom" />
                                        <MenuItem
                                            x:Name="MenuSetRollDirLeft"
                                            Click="MenuSetRollDir_Click"
                                            Header="Left"
                                            Icon="{StaticResource ItemIcon_Roll_Left}"
                                            IsCheckable="True"
                                            Tag="Left" />
                                        <MenuItem
                                            x:Name="MenuSetRollDirRight"
                                            Click="MenuSetRollDir_Click"
                                            Header="Right"
                                            Icon="{StaticResource ItemIcon_Roll_Right}"
                                            IsCheckable="True"
                                            Tag="Right" />
                                    </MenuItem>
                                    <MenuItem x:Name="MenuIconSize" Header="Icon Size">
                                        <MenuItem
                                            x:Name="MenuIconSizeAuto"
                                            Click="MenuSetIconSize_Click"
                                            Header="Auto / Default"
                                            Icon="{StaticResource ItemIcon_Size_Small}"
                                            IsCheckable="True"
                                            Tag="Auto" />
                                        <Separator />
                                        <MenuItem
                                            x:Name="MenuIconSizeSmall"
                                            Click="MenuSetIconSize_Click"
                                            Header="Small"
                                            IsCheckable="True"
                                            Tag="Small" />
                                        <MenuItem
                                            x:Name="MenuIconSizeMid"
                                            Click="MenuSetIconSize_Click"
                                            Header="Mid"
                                            IsCheckable="True"
                                            Tag="Mid" />
                                        <MenuItem
                                            x:Name="MenuIconSizeLarge"
                                            Click="MenuSetIconSize_Click"
                                            Header="Large"
                                            IsCheckable="True"
                                            Tag="Large" />
                                        <Separator />
                                        <!--
                                            Custom pixel size: stays open while dragging (no Click on this
                                            item), value applied + saved from code-behind.
                                        -->
                                        <MenuItem Focusable="False" StaysOpenOnClick="True">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="30"
                                                        VerticalAlignment="Center"
                                                        Text="Px" />
                                                    <Slider
                                                        x:Name="MenuIconSizeSlider"
                                                        Width="132"
                                                        IsMoveToPointEnabled="True"
                                                        IsSnapToTickEnabled="True"
                                                        Maximum="128"
                                                        Minimum="16"
                                                        TickFrequency="4"
                                                        ValueChanged="MenuIconSizeSlider_ValueChanged" />
                                                    <TextBlock
                                                        x:Name="MenuIconSizeValueText"
                                                        Width="44"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="32px" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Click="MenuDelete_Click"
                                        Foreground="OrangeRed"
                                        Header="Delete"
                                        Icon="{StaticResource ItemIcon_Delete}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Grid
                            x:Name="TitleArea"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
                            <Grid
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    x:Name="TitleFolderIcon"
                                    Grid.Column="0"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BoxHeaderForeground}"
                                    Symbol="Folder24"
                                    Visibility="{Binding ActiveBox.IsFolderPortal, Converter={StaticResource BoolToVis}}" />
                                <TextBlock
                                    x:Name="TitleText"
                                    Grid.Column="1"
                                    MinWidth="40"
                                    MaxWidth="220"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    MouseLeftButtonDown="TitleText_MouseLeftButtonDown"
                                    Text="{Binding Title}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBox
                                x:Name="TitleEdit"
                                MinWidth="120"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                KeyDown="TitleEdit_KeyDown"
                                LostFocus="TitleEdit_LostFocus"
                                Text="{Binding ActiveBox.Name, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center"
                                Visibility="Collapsed" />
                        </Grid>

                        <Button
                            x:Name="RollButton"
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="RollButton_Click"
                            Cursor="Arrow"
                            Style="{StaticResource BorderlesButtonStyle}"
                            ToolTip="Roll up">
                            <ui:SymbolIcon x:Name="RollIcon" Symbol="ChevronUp24" />
                        </Button>
                    </Grid>
                </Border>

                <!--  Tab strip: only shown for more than one tab AND when the container is active/hovered  -->
                <Border
                    x:Name="TabStrip"
                    MaxHeight="36"
                    Padding="4,2"
                    Background="Transparent"
                    BorderThickness="0"
                    DockPanel.Dock="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl x:Name="TabItems" ItemsSource="{Binding BoxContainerVm.Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:TabStripPanel GapIndex="-1" GapWidth="22" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:BoxViewModel">
                                    <Button
                                        HorizontalContentAlignment="Center"
                                        AllowDrop="True"
                                        Cursor="Hand"
                                        DragEnter="TabItem_DragEnter"
                                        DragLeave="TabItem_DragLeave"
                                        DragOver="TabItem_DragOver"
                                        Drop="TabItem_Drop"
                                        PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="{Binding}">
                                        <Grid VerticalAlignment="Center" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Symbol="Folder24"
                                                Visibility="{Binding IsFolderPortal, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle
                            x:Name="TabDropIndicator"
                            Width="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Fill="#4EC9B0"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid x:Name="BodyContent">
                    <containersControls:BoxControl x:Name="BoxContent" DataContext="{Binding ActiveBox}" />
                    <containersControls:FolderPortalControl
                        x:Name="FolderPortalContent"
                        DataContext="{Binding ActiveBox}"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="Placeholder"
                        Padding="16"
                        Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                Foreground="White"
                                Text="Custom Widget"
                                TextAlignment="Center" />
                            <TextBlock
                                Foreground="#cccccc"
                                Text="{Binding CustomTypeName}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
            <ui:ContentDialogHost x:Name="RootContentDialogHost" />
        </Grid>
    </Border>
</containers:WidgetWindow>
