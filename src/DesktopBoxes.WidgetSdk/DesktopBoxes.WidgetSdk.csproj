<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(SharedTargetFrameworWindows)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<Description>Plugin contracts for authoring Desktop Boxes native widgets.</Description>
		<IsTrimmable>false</IsTrimmable>
		<EnableAot>false</EnableAot>
	</PropertyGroup>

	<!-- Plugin contracts only: BCL + WPF framework, no packages, so third-party
	     authors get a tiny dependency footprint. The host (DesktopBoxesUI) references
	     this project; plugin assemblies reference the built DLL. -->

</Project>
