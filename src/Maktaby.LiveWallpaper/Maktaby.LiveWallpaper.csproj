<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(SharedTargetFrameworWindows)</TargetFramework>
		<TargetPlatformMinVersion>$(SharedTargetPlatformMinVersion)</TargetPlatformMinVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Description>Live wallpaper rendering engine for Maktaby.</Description>
		<!-- Microsoft.Web.WebView2 unconditionally references its Wpf/WinForms assemblies even
		     in non-WPF projects; the Wpf ref unifies WindowsBase 5.0 against the framework 4.0
		     (MSB3277). Only Core is ever loaded at runtime, so the conflict is benign. -->
		<NoWarn>$(NoWarn);MSB3277</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Serilog" />
		<PackageReference Include="Microsoft.Web.WebView2" />
		<!-- System.Drawing.Common only: Microsoft.Windows.Compatibility used to ride along and
		     shipped ~8 MB of assemblies nothing here calls (System.Management, ServiceProcess,
		     ServiceModel, DirectoryServices, Speech, IO.Ports, Web.Services, Runtime.Caching,
		     ComponentModel.Composition). System.Drawing.Common is what the renderers use. -->
		<PackageReference Include="System.Drawing.Common" />
		<PackageReference Include="Vortice.Direct2D1" />
		<PackageReference Include="Vortice.Direct3D11" />
		<PackageReference Include="Vortice.DirectComposition" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Maktaby.Native\Maktaby.Native.csproj" />
	</ItemGroup>
</Project>