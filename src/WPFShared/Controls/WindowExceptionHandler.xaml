<ui:FluentWindow
    x:Class="WPFShared.Controls.WindowExceptionHandler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Unexpected error"
    Width="680"
    MinWidth="640"
    MinHeight="380"
    MaxHeight="680"
    d:DataContext="{d:DesignInstance Type=ui:FluentWindow}"
    Closing="OnWindowClosing"
    ExtendsContentIntoTitleBar="True"
    Loaded="OnWindowLoaded"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Unexpected error"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="True" />

        <!--  Content  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,12"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Header: icon + title + description  -->
                <Grid Margin="0,8,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="48"
                        Height="48"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="24">
                        <ui:SymbolIcon
                            FontSize="24"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Symbol="ErrorCircle24" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="Something went wrong" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="An unexpected error occurred. The application state might be corrupted. You can continue at your own risk or exit now."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  Details card — theme aware, no hard-coded colors  -->
                <Border
                    Margin="0,0,0,8"
                    Padding="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Expander
                        Margin="0"
                        Padding="12,8,12,12"
                        Header="Exception details"
                        IsExpanded="False">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding}" />
                            </DataTemplate>
                        </Expander.HeaderTemplate>

                        <ScrollViewer
                            MaxHeight="320"
                            Margin="0,8,0,0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock
                                    Margin="0,8,0,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="EXCEPTION MESSAGE" />
                                <TextBox
                                    IsReadOnly="True"
                                    Style="{StaticResource {x:Type TextBox}}"
                                    Text="{Binding Exception.Message, Mode=OneWay, TargetNullValue=-}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,12,0,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="EXCEPTION TYPE" />
                                <TextBox
                                    IsReadOnly="True"
                                    Style="{StaticResource {x:Type TextBox}}"
                                    Text="{Binding ExceptionType, Mode=OneWay, TargetNullValue=-}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,12,0,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="CALL STACK" />
                                <TextBox
                                    MinHeight="60"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    IsReadOnly="True"
                                    Text="{Binding Exception.StackTrace, Mode=OneWay, TargetNullValue=-}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />

                                <TextBlock
                                    Margin="0,12,0,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="INNER EXCEPTION"
                                    Visibility="{Binding HasInnerException, Converter={StaticResource BoolToVis}}" />
                                <TextBox
                                    IsReadOnly="True"
                                    Style="{StaticResource {x:Type TextBox}}"
                                    Text="{Binding Exception.InnerException, Mode=OneWay, TargetNullValue=-}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasInnerException, Converter={StaticResource BoolToVis}}" />

                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Border>

                <!--  Warning InfoBar  -->
                <ui:InfoBar
                    Title="Continue at your own risk"
                    Margin="0,4,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Message="If you choose Continue, the app will keep running but some features may not work correctly. Please consider restarting and reporting the issue."
                    Severity="Warning" />
            </StackPanel>
        </ScrollViewer>

        <!--  Footer buttons  -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Appearance="Secondary"
                    Command="{Binding CopyDetailsCommand}"
                    Content="Copy details"
                    Icon="{ui:SymbolIcon Copy24}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Appearance="Secondary"
                        Click="OnContinueClick"
                        Content="Continue"
                        Icon="{ui:SymbolIcon Play24}" />
                    <ui:Button
                        MinWidth="130"
                        Appearance="Danger"
                        Click="OnExitAppClick"
                        Content="Exit Application"
                        Icon="{ui:SymbolIcon DoorArrowRight20}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
