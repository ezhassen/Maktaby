<UserControl
    x:Class="Maktaby.Controls.VirtualizingItemsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Maktaby.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ItemsControl
        x:Name="PART_ItemsControl"
        VirtualizingStackPanel.IsVirtualizing="True">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer
                    x:Name="PART_ScrollViewer"
                    CanContentScroll="True"
                    HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <controls:VirtualizingIconPanel
                    HorizontalSpacing="{Binding HorizontalSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ItemHeight="{Binding ItemHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ItemWidth="{Binding ItemWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalSpacing="{Binding VerticalSpacing, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>