<local:WidgetControlBase
    x:Class="Maktaby.Controls.ContainersControls.FolderPortalControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Maktaby.Controls"
    xmlns:conv="clr-namespace:Maktaby.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Maktaby.Controls.ContainersControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tt="clr-namespace:Maktaby.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Maktaby.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="400"
    PreviewMouseDown="Control_PreviewMouseDown"
    PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
    PreviewMouseLeftButtonUp="FolderPortal_PreviewMouseLeftButtonUp"
    PreviewMouseRightButtonUp="FolderPortal_PreviewMouseRightButtonUp"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!--  Filter: INVERTED, because the flag means "hidden".  -->
        <conv:BoolInvertedToVisibilityConverter x:Key="BoolToVisInverted" />
        <conv:AdaptiveTileSizeConverter x:Key="TileWidth" />
        <conv:TileSizeToSizeConverter x:Key="TileSize" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />

        <!--
            Empty-surface menu. A right-click ON a row still shows the native shell menu. Here
            the paste is a real file copy/move into the portal's folder, done by the shell.
            The header is set in code rather than with LocKey: the markup extension throws an
            opaque MC1000 ("value cannot be null, key") at XAML compile time in THIS file
            while the identical construct compiles fine in BoxControl.xaml.
        -->
        <ContextMenu x:Key="FolderEmptySpaceMenu" Opened="FolderEmptySpaceMenu_Opened">
            <MenuItem Click="FolderEmptySpacePaste_Click" InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="16" Symbol="Clipboard20" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BoxBackground}">
        <!--  Placeholder when no folder selected / missing  -->
        <StackPanel
            x:Name="PlaceholderPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="13"
                Foreground="{DynamicResource BoxForeground}"
                Opacity="0.8"
                Text="No folder selected"
                TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFolderPath}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFolderMissing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    Margin="0,0,0,2"
                    FontSize="13"
                    Foreground="#FF6B6B"
                    Text="Folder not found"
                    TextAlignment="Center" />
                <TextBlock
                    MaxWidth="260"
                    Margin="0,0,0,8"
                    FontSize="11"
                    Foreground="{DynamicResource BoxForeground}"
                    Opacity="0.7"
                    Text="{Binding FolderPath}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="11"
                    Foreground="{DynamicResource BoxForeground}"
                    Opacity="0.6"
                    Text="It was deleted or moved."
                    TextAlignment="Center" />
            </StackPanel>
            <Button
                Margin="0,8,0,0"
                Padding="12,6"
                Click="SelectFolder_Click"
                Content="Select Folder"
                Cursor="Hand" />
        </StackPanel>

        <!--  Main content when folder selected  -->
        <Grid x:Name="ContentPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  Navigation bar  -->
            <Border
                Grid.Row="0"
                Padding="4"
                Background="{DynamicResource BoxBackground}"
                BorderBrush="{DynamicResource BoxBorder}"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Button
                        x:Name="BackButton"
                        Grid.Column="0"
                        Padding="6,2"
                        Click="Back_Click"
                        Content="←"
                        ToolTip="Go up" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource BoxForeground}"
                        Opacity="0.7"
                        Text="{Binding CurrentFolderPath, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding CurrentFolderPath, FallbackValue=''}" />
                    <Button
                        x:Name="ViewToggleButton"
                        Grid.Column="2"
                        Padding="6,2"
                        Click="ToggleView_Click"
                        Cursor="Hand"
                        ToolTip="Toggle view">
                        <ui:SymbolIcon x:Name="ViewToggleIcon" Symbol="AppsListDetail24" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Padding="6,2"
                        Click="OpenFolder_Click"
                        Content="Open"
                        Cursor="Hand"
                        ToolTip="Open folder in Explorer" />
                    <Button
                        Grid.Column="4"
                        Margin="4,0,0,0"
                        Padding="6,2"
                        Click="SelectFolder_Click"
                        Content="Change..."
                        Cursor="Hand"
                        ToolTip="Change folder" />
                </Grid>
            </Border>

            <!--  Icons sorting bar  -->
            <Border
                x:Name="IconsSortBar"
                Grid.Row="1"
                Padding="4,2"
                Background="{DynamicResource BoxBackground}"
                BorderBrush="{DynamicResource BoxBorder}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource BoxForeground}"
                        Opacity="0.7"
                        Text="Sort:" />
                    <ComboBox
                        x:Name="IconsSortCombo"
                        Width="130"
                        FontSize="11"
                        SelectionChanged="IconsSortCombo_SelectionChanged">
                        <ComboBoxItem Content="Name" Tag="Name" />
                        <ComboBoxItem Content="Size" Tag="Size" />
                        <ComboBoxItem Content="Type" Tag="Type" />
                        <ComboBoxItem Content="Date modified" Tag="Date modified" />
                    </ComboBox>
                    <Button
                        x:Name="IconsSortDirectionButton"
                        Margin="6,0,0,0"
                        Padding="6,2"
                        Click="IconsSortDirection_Click"
                        ToolTip="Toggle ascending/descending">
                        <TextBlock
                            x:Name="IconsSortArrow"
                            FontSize="11"
                            Text="▲" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  Icons view: VirtualizingIconPanel (now stable) instead plain WrapPanel  -->
            <controls:VirtualizingItemsControl
                x:Name="IconsList"
                Grid.Row="2"
                Background="{DynamicResource BoxBackground}"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalSpacing="0"
                ItemHeight="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}, Converter={StaticResource TileWidth}, ConverterParameter=40}"
                ItemWidth="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}, Converter={StaticResource TileWidth}, ConverterParameter=40}"
                ItemsSource="{Binding FolderItems}"
                PreviewMouseLeftButtonDown="IconsHost_PreviewMouseLeftButtonDown"
                VerticalScrollBarVisibility="Auto"
                VerticalSpacing="0">
                <controls:VirtualizingItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:FolderItemViewModel">
                        <Border
                            Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}, Converter={StaticResource TileWidth}, ConverterParameter=36}"
                            Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}, Converter={StaticResource TileWidth}, ConverterParameter=36}"
                            Margin="2"
                            tt:ToolTipGuard.Managed="True"
                            ContextMenuOpening="ItemBorder_ContextMenuOpening"
                            Cursor="Arrow"
                            Focusable="True"
                            GotFocus="ItemBorder_GotFocus"
                            KeyDown="ItemBorder_KeyDown"
                            MouseLeftButtonDown="ItemBorder_MouseLeftButtonDown"
                            MouseLeftButtonUp="ItemBorder_MouseLeftButtonUp"
                            MouseMove="ItemBorder_MouseMove"
                            MouseRightButtonUp="ItemBorder_MouseRightButtonUp"
                            PreviewMouseDown="ItemBorder_PreviewMouseDown"
                            ToolTip="{Binding Path}"
                            Visibility="{Binding IsFilteredOut, Converter={StaticResource BoolToVisInverted}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#407FB2FF" />
                                            <Setter Property="BorderBrush" Value="#FF7FB2FF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Vertical">
                                <Image
                                    Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}}"
                                    Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}}"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Icon}" />
                                <TextBlock
                                    MaxHeight="32"
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource BoxForeground}"
                                    Text="{Binding DisplayName}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </controls:VirtualizingItemsControl.ItemTemplate>
            </controls:VirtualizingItemsControl>


            <!--  Details view: DataGrid  -->
            <DataGrid
                x:Name="DetailsGrid"
                Grid.Row="2"
                AutoGenerateColumns="False"
                Background="{DynamicResource BoxBackground}"
                BorderBrush="{DynamicResource BoxBorder}"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                CanUserResizeRows="False"
                CanUserSortColumns="True"
                EnableColumnVirtualization="False"
                EnableRowVirtualization="True"
                Foreground="{DynamicResource BoxForeground}"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding FolderItems}"
                PreviewMouseLeftButtonDown="DetailsGrid_PreviewMouseLeftButtonDown"
                RowHeaderWidth="0"
                RowHeight="22"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                SelectionChanged="DetailsGrid_SelectionChanged"
                Sorting="DetailsGrid_Sorting"
                VirtualizingPanel.IsContainerVirtualizable="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                Visibility="Collapsed">
                <DataGrid.Resources>
                    <!--  Dotted focus rectangle for the focused cell (replaces FocusVisualStyle={x:Null})  -->
                    <Style x:Key="CellDottedFocusVisualStyle">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle
                                        Margin="1"
                                        SnapsToDevicePixels="True"
                                        Stroke="White"
                                        StrokeDashArray="1 2"
                                        StrokeThickness="1" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="{DynamicResource BoxHeaderBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource BoxHeaderForeground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                    </Style>
                    <Style TargetType="{x:Type ScrollViewer}">
                        <Setter Property="Background" Value="{DynamicResource BoxBackground}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <EventSetter Event="GotFocus" Handler="DetailsRow_GotFocus" />
                        <EventSetter Event="GotKeyboardFocus" Handler="DetailsRow_GotFocus" />
                        <Setter Property="Focusable" Value="True" />
                        <Setter Property="Background" Value="#01000000" />
                        <Setter Property="Foreground" Value="{DynamicResource BoxForeground}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <!--
                                Filter: collapse the row rather than removing it, so every index in
                                FolderItems stays valid for selection, focus and scrolling.
                            -->
                            <DataTrigger Binding="{Binding IsFilteredOut}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!--
                                    Theme-aware: a fixed dark hover over the light theme's background
                                    made the row unreadable.
                                -->
                                <Setter Property="Background" Value="{DynamicResource BoxHoverBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#407FB2FF" />
                                <Setter Property="BorderBrush" Value="#FF7FB2FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <!--
                                    A stronger tint of the same blue, so the text stays readable over
                                    it in both themes.
                                -->
                                <Setter Property="Background" Value="#66A0FF" />
                            </MultiTrigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF7FB2FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Background" Value="#01000000" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="True" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource CellDottedFocusVisualStyle}" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="Margin" Value="2,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="11" />
                        <!--  Keep dotted focus visible even when selected  -->
                        <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#01000000" />
                                <Setter Property="Foreground" Value="{DynamicResource BoxForeground}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="220"
                        MinWidth="60"
                        CanUserReorder="True"
                        CanUserResize="True"
                        CanUserSort="True"
                        Header="Name"
                        SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="vm:FolderItemViewModel">
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding Icon}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="90"
                        MinWidth="60"
                        Binding="{Binding SizeText}"
                        CanUserResize="True"
                        CanUserSort="True"
                        ElementStyle="{StaticResource {x:Type TextBlock}}"
                        Header="Size"
                        SortMemberPath="FileSize" />
                    <DataGridTextColumn
                        Width="90"
                        MinWidth="60"
                        Binding="{Binding TypeName}"
                        CanUserResize="True"
                        CanUserSort="True"
                        Header="Type"
                        SortMemberPath="TypeName" />
                    <DataGridTextColumn
                        Width="150"
                        MinWidth="60"
                        Binding="{Binding ModifiedText}"
                        CanUserResize="True"
                        CanUserSort="True"
                        Header="Date modified"
                        SortMemberPath="ModifiedTime" />
                </DataGrid.Columns>
            </DataGrid>
            <!--
                Lazy-load indicator: folder tabs enumerate off the UI thread on first selection.
                Last sibling so it renders above the views; hit-test off so it never blocks input.
            -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Orientation="Vertical"
                Visibility="{Binding IsLoadingFolder, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing IsIndeterminate="{Binding IsLoadingFolder}" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource BoxForeground}"
                    Opacity="0.7"
                    Text="Loading folder…"
                    TextAlignment="Center" />
            </StackPanel>
            <!--
                Paste / copy indicator, same shape as BoxControl's. IsIndeterminate is
                BOUND, not a constant True: an indeterminate ring keeps animating even while
                Collapsed, which is a permanent render loop per portal.
            -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,8"
                Padding="10,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#CC1E1E1E"
                BorderBrush="#FF7FB2FF"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Visibility="{Binding IsCopyingFiles, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="16"
                        Height="16"
                        IsIndeterminate="{Binding IsCopyingFiles, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="White"
                        Text="{Binding CopyStatusText, RelativeSource={RelativeSource AncestorType=local:FolderPortalControl}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</local:WidgetControlBase>
