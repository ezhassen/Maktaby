<Application
    x:Class="Maktaby.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!--  Missing brush referenced by some Wpf.Ui button styles  -->
            <SolidColorBrush x:Key="PressedForeground" Color="White" />

            <SolidColorBrush x:Key="BoxBackground" Color="#2d2d30" />
            <SolidColorBrush x:Key="BoxForeground" Color="White" />
            <SolidColorBrush x:Key="BoxBorder" Color="#3f3f46" />
            <SolidColorBrush x:Key="BoxHeaderBackground" Color="#3f3f46" />
            <SolidColorBrush x:Key="BoxHeaderForeground" Color="White" />
            <Thickness x:Key="BoxBorderThickness">1</Thickness>

            <ResourceDictionary.MergedDictionaries>

                <ui:ThemesDictionary />
                <ui:ControlsDictionary />

                <!--
                    App-wide overrides. Merged AFTER WPF-UI so the fixed menu item templates
                    (submenu positioning + checkable state) win over the stock ones.
                -->
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
