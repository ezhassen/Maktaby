<appwin:AppFluentWindow
    x:Class="Maktaby.Views.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appwin="clr-namespace:Maktaby.Views.AppWindows"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Logs"
    Width="900"
    Height="640"
    MinWidth="560"
    MinHeight="380"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Shared title bar (AppFluentWindow): title syncs from Window.Title.  -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding TitleBar, RelativeSource={RelativeSource AncestorType={x:Type appwin:AppFluentWindow}}}"
            Focusable="False" />

        <!--  Toolbar: day file picker + reload + follow + folder  -->
        <StackPanel
            Grid.Row="1"
            Margin="12,6,12,6"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Log file" />
            <ComboBox
                x:Name="FilePicker"
                MinWidth="280"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                DisplayMemberPath="Name"
                SelectionChanged="FilePicker_SelectionChanged"
                ToolTip="One file per day; numbered chunks (_001, …) are same-day size rolls" />
            <ui:Button
                Margin="8,0,0,0"
                Padding="8,2"
                Appearance="Secondary"
                Click="Reload_Click"
                Content="Reload"
                FontSize="11"
                ToolTip="Re-read the selected file from disk" />
            <CheckBox
                
                x:Name="FollowTailCheck"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Follow tail"
                IsChecked="True"
                ToolTip="Append new lines as they are written and keep the end visible" />
            <ui:Button
                Margin="12,0,0,0"
                Padding="8,2"
                Appearance="Secondary"
                Click="OpenFolder_Click"
                Content="Open folder"
                FontSize="11"
                ToolTip="Open the logs folder in Explorer" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Margin="12,0,12,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <avalonEdit:TextEditor
                x:Name="LogBox"
                Padding="6,4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                ShowLineNumbers="True"
                VerticalScrollBarVisibility="Auto"
                WordWrap="False" />
        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Margin="12,0,12,8"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="No log file loaded"
            TextWrapping="Wrap" />
    </Grid>
</appwin:AppFluentWindow>
