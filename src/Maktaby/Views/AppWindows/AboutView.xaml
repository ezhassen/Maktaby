<appwin:AppFluentWindow
    x:Class="Maktaby.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appwin="clr-namespace:Maktaby.Views.AppWindows"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About"
    Width="440"
    Height="420"
    Icon="pack://application:,,,/Assets/app.ico"
    MouseLeftButtonDown="Root_MouseLeftButtonDown"
    PreviewKeyDown="Window_PreviewKeyDown"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="auto, *">
        <!--  Shared title bar (AppFluentWindow): title syncs from Window.Title.  -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding TitleBar, RelativeSource={RelativeSource AncestorType={x:Type appwin:AppFluentWindow}}}"
            Focusable="False" />


        <Grid Grid.Row="1" Margin="24,2,24,12">
            <StackPanel VerticalAlignment="Center">

                <Image
                    Width="72"
                    Height="72"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="/Assets/app_image.png" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="Maktaby" />

                <TextBlock
                    x:Name="VersionText"
                    Margin="0,4,0,12"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Version" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Boxes (for files and folders), live wallpapers and widgets for your windows desktop."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Separator Margin="0,14,0,8" />

                <TextBlock
                    x:Name="AuthorText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="© Ezz Hassan" />

                <TextBlock
                    x:Name="CopyrightText"
                    Margin="0,2,0,8"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!--
                    TextAlignment centers each inline line (logo line + label line) inside this block;
                    the label gets the logo's 64px width so both center identically.
                -->
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center">
                    <!--
                        TextDecorations={x:Null} removes the default underline, which otherwise draws
                        a line beneath the hosted image too.
                    -->
                    <Hyperlink
                        FontWeight="Bold"
                        NavigateUri="https://github.com/ezhassen/DesktopBoxes"
                        RequestNavigate="ProjectLink_RequestNavigate"
                        TextDecorations="{x:Null}"
                        ToolTip="https://github.com/ezhassen/DesktopBoxes">
                        <Image
                            x:Name="GithubLogo"
                            Width="64"
                            Height="64"
                            Margin="0,0,0,4"
                            HorizontalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Assets/github_light.png" />
                        <LineBreak />
                        <TextBlock
                            Width="64"
                            HorizontalAlignment="Center"
                            Text="Github"
                            TextAlignment="Center" />
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </Grid>
    </Grid>

</appwin:AppFluentWindow>
