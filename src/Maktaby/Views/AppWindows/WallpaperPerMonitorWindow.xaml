<appwin:AppFluentWindow
    x:Class="Maktaby.Views.AppWindows.WallpaperPerMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appwin="clr-namespace:Maktaby.Views.AppWindows"
    xmlns:converters="clr-namespace:Maktaby.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:Maktaby.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="{loc:LocKey WallpaperPerMonitor.Title}"
    Width="800"
    Height="680"
    MinWidth="760"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <appwin:AppFluentWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolInvertedToVisibilityConverter x:Key="BoolInvertedToVis" />
    </appwin:AppFluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Shared title bar  -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding TitleBar, RelativeSource={RelativeSource AncestorType={x:Type appwin:AppFluentWindow}}}"
            Focusable="False" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="367*" />
                <ColumnDefinition Width="107*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Default / all monitors card  -->
            <Border
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="160"
                        Height="90"
                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                        CornerRadius="6">
                        <Grid>
                            <Image
                                x:Name="DefaultImage"
                                Source="{Binding DefaultPreview}"
                                Stretch="UniformToFill" />
                            <Border
                                Margin="4"
                                Padding="4,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#80000000"
                                CornerRadius="4"
                                Visibility="{Binding DefaultHasMedia, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{Binding DefaultMediaType}" />
                            </Border>
                            <MediaElement
                                x:Name="DefaultVideoPlayer"
                                Panel.ZIndex="1"
                                LoadedBehavior="Manual"
                                Stretch="UniformToFill"
                                UnloadedBehavior="Stop"
                                Visibility="Collapsed" />
                            <wv2:WebView2CompositionControl
                                x:Name="DefaultWebView"
                                Panel.ZIndex="1"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Text="*" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{loc:LocKey WallpaperPerMonitor.Monitor}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{loc:LocKey WallpaperPerMonitor.DefaultAll}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="{Binding DefaultDisplayPath}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding DefaultPath}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="OrangeRed"
                            Text="{Binding DefaultWarningText}"
                            Visibility="{Binding DefaultHasWarning, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:Button
                                x:Name="DefaultPlayPauseButton"
                                Click="DefaultPlayPause_Click"
                                Content="{loc:LocKey WallpaperPerMonitor.Play}"
                                Visibility="{Binding DefaultIsVideo, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                x:Name="DefaultStopButton"
                                Margin="8,0,0,0"
                                Click="DefaultStop_Click"
                                Content="{loc:LocKey WallpaperPerMonitor.Stop}"
                                Visibility="{Binding DefaultIsVideo, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Click="DefaultBrowseButton_Click"
                            Content="{loc:LocKey WallpaperPerMonitor.Browse}"
                            Icon="{ui:SymbolIcon Folder24}" />
                        <ui:Button
                            Appearance="Danger"
                            Click="DefaultRemoveButton_Click"
                            Content="{loc:LocKey WallpaperPerMonitor.Remove}"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Monitors list  -->
            <ScrollViewer
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MonitorList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="160"
                                        Height="90"
                                        Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                        CornerRadius="6">
                                        <Grid>
                                            <Image
                                                x:Name="RowImage"
                                                Source="{Binding Preview}"
                                                Stretch="UniformToFill" />
                                            <Border
                                                Margin="4"
                                                Padding="4,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="#80000000"
                                                CornerRadius="4"
                                                Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="White"
                                                    Text="{Binding MediaType}" />
                                            </Border>
                                            <MediaElement
                                                x:Name="RowVideoPlayer"
                                                Panel.ZIndex="1"
                                                LoadedBehavior="Manual"
                                                Stretch="UniformToFill"
                                                UnloadedBehavior="Stop"
                                                Visibility="Collapsed" />
                                            <wv2:WebView2CompositionControl
                                                x:Name="RowWebView"
                                                Panel.ZIndex="1"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,12,0"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DeviceName}" />
                                            <Border
                                                Margin="8,0,0,0"
                                                Padding="6,2"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="10" Text="{loc:LocKey WallpaperPerMonitor.Connected}" />
                                            </Border>
                                            <Border
                                                Margin="8,0,0,0"
                                                Padding="6,2"
                                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                                CornerRadius="4"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BoolInvertedToVis}}">
                                                <TextBlock FontSize="10" Text="{loc:LocKey WallpaperPerMonitor.NotConnected}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Text="{Binding DisplayPath}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Path}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="OrangeRed"
                                            Text="{Binding WarningText}"
                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <ui:Button
                                                x:Name="RowPlayPauseButton"
                                                Click="RowPlayPause_Click"
                                                Content="{loc:LocKey WallpaperPerMonitor.Play}"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                            <ui:Button
                                                x:Name="RowStopButton"
                                                Margin="8,0,0,0"
                                                Click="RowStop_Click"
                                                Content="{loc:LocKey WallpaperPerMonitor.Stop}"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,8,0"
                                            Click="BrowseButton_Click"
                                            Content="{loc:LocKey WallpaperPerMonitor.Browse}"
                                            Icon="{ui:SymbolIcon Folder24}" />
                                        <ui:Button
                                            Appearance="Danger"
                                            Click="RemoveButton_Click"
                                            Content="{loc:LocKey WallpaperPerMonitor.Remove}"
                                            Icon="{ui:SymbolIcon Delete24}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  Bottom  -->
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="90"
                    Click="CloseButton_Click"
                    Content="{loc:LocKey Dialog.Close}" />
            </StackPanel>
        </Grid>
    </Grid>
</appwin:AppFluentWindow>