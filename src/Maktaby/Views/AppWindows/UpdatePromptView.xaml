<appwin:AppFluentWindow
    x:Class="Maktaby.Views.UpdatePromptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appwin="clr-namespace:Maktaby.Views.AppWindows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Update available"
    Width="520"
    SizeToContent="Height"
    MinWidth="440"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{Binding Source={x:Static appwin:DesignTimeData.SampleUpdatePrompt}}"
    mc:Ignorable="d">

    <appwin:AppFluentWindow.Resources>
        <Style x:Key="HeadingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </appwin:AppFluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Shared title bar (AppFluentWindow) so this window matches every other app window
              and repaints correctly when the app theme changes.  -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding TitleBar, RelativeSource={RelativeSource AncestorType={x:Type appwin:AppFluentWindow}}}"
            Focusable="False" />

        <!--  Version comparison: the actual reason this window exists.  -->
        <StackPanel Grid.Row="1" Margin="20,16,20,0">
            <TextBlock Style="{StaticResource HeadingText}" Text="{Binding NewVersionText}" />
            <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource MutedText}"
                Text="{Binding CurrentVersionText}" />
            <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource MutedText}"
                Text="{Binding PublishedText}"
                Visibility="{Binding PublishedText, Converter={StaticResource StringToVisibilityConverter}}" />
        </StackPanel>

        <!--  Release notes excerpt. Scrollable with a capped height so a long changelog cannot
              grow the window past the screen.  -->
        <Border
            Grid.Row="2"
            Margin="20,12,20,0"
            MaxHeight="140"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding NotesText, Converter={StaticResource StringToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock
                    FontFamily="Consolas"
                    FontSize="11"
                    Text="{Binding NotesText}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!--  Download progress. Collapsed until an install is actually running. The ring's
              Value is bound and IsIndeterminate is set from code together with IsInstalling,
              so no animation clock runs while the panel is hidden (AGENTS.md on looping visuals).  -->
        <StackPanel
            Grid.Row="3"
            Margin="20,14,20,0"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock FontSize="11" Text="{Binding StatusText}" TextWrapping="Wrap" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Text="{Binding ErrorText}"
                TextWrapping="Wrap"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Plain WPF ProgressBar, not a ui: control: the value is driven by a real
                      download percentage, and Wpf.Ui has no determinate bar. Deterministic value
                      (never IsIndeterminate) also means no animation clock runs while hidden.  -->
                <ProgressBar
                    Grid.Column="0"
                    Height="6"
                    HorizontalAlignment="Left"
                    Width="380"
                    Maximum="100"
                    Value="{Binding Progress, Mode=OneWay}" />
                <!--  Exactly one of these shows at a time: Cancel while the download can still
                      be abandoned (IsCancellable goes false the moment the installer is
                      launched), or Retry once an attempt has failed (HasError).  -->
                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Click="Cancel_Click"
                    Content="Cancel"
                    Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Click="Retry_Click"
                    Content="Retry"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </StackPanel>

        <StackPanel
            Grid.Row="4"
            Margin="20,18,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Click="Skip_Click"
                Content="Skip this version"
                IsEnabled="{Binding CanChoose}" />
            <ui:Button
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="Later_Click"
                Content="Update later"
                IsEnabled="{Binding CanChoose}" />
            <ui:Button
                Appearance="Primary"
                Click="Install_Click"
                Content="Update now"
                IsEnabled="{Binding CanChoose}" />
        </StackPanel>
    </Grid>
</appwin:AppFluentWindow>
