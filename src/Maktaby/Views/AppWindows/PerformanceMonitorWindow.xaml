<appwin:AppFluentWindow
    x:Class="Maktaby.Views.PerformanceMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Maktaby.Localization"
    xmlns:appwin="clr-namespace:Maktaby.Views.AppWindows"
    xmlns:controls="clr-namespace:Maktaby.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Maktaby.ViewModels"
    Title="{loc:LocKey Perf.Title}"
    Width="760"
    Height="800"
    MinWidth="640"
    MinHeight="480"
    d:DataContext="{Binding Source={x:Static appwin:DesignTimeData.SamplePerformance}}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                Star so the Windows grid fills leftover space and scrolls internally, with a
                floor so short windows squeeze other sections instead of collapsing the grid
                to zero. Code-behind flips this to Auto/MinHeight 0 while the Windows section
                is collapsed — a star row would otherwise hold the empty space and pin the
                sections below instead of letting them snap up under the header. The spacer
                below takes over the star in that state so the footer stays pinned to the
                window bottom in both states.
            -->
            <RowDefinition x:Name="WindowsRow" Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BottomSpacerRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Shared title bar (AppFluentWindow): title syncs from Window.Title.  -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding TitleBar, RelativeSource={RelativeSource AncestorType={x:Type appwin:AppFluentWindow}}}"
            Focusable="False" />

        <!--  Summary  -->
        <controls:CollapsibleGroupBox
            Grid.Row="1"
            Margin="12,6,12,6"
            BodyPadding="8"
            IsExpanded="{Binding IsSummaryExpanded, Mode=TwoWay}">
            <controls:CollapsibleGroupBox.HeaderContent>
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{loc:LocKey Perf.Overview}" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{loc:LocKey Perf.AppStatus}"
                            ToolTip="{loc:LocKey Perf.AppStatusTooltip}" />
                        <Border
                            x:Name="IdleBadge"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            CornerRadius="12"
                            ToolTip="{loc:LocKey Perf.StatusLegend}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#D0F0D0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIdleMode}" Value="True">
                                            <Setter Property="Background" Value="#FFE8A0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#1A1A1A">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Active" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIdleMode}" Value="True">
                                                <Setter Property="Text" Value="Idle" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:CollapsibleGroupBox.HeaderContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:LocKey Perf.AppProcess}"
                        ToolTip="{loc:LocKey Perf.PrivateWsTooltip}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding TotalMemoryMB, StringFormat={}{0} MB}"
                            ToolTip="{loc:LocKey Perf.PrivateWsTooltip2}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding TotalCpu, StringFormat={}{0:0.0}% CPU}"
                            ToolTip="{loc:LocKey Perf.CpuTooltip}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding TotalIo}"
                        ToolTip="{loc:LocKey Perf.IOThumb}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding ManagedMemoryMB, StringFormat={}Managed heap: {0} MB}"
                        ToolTip=".NET managed heap. If this stays flat while the total climbs, the growth is native (media, COM, graphics) rather than .NET objects." />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding WorkingSetMB, StringFormat={}Working set: {0} MB}"
                        ToolTip="{loc:LocKey Perf.WorkingSetTooltip}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding TotalPrivateMB, StringFormat={}Private (commit): {0} MB}"
                        ToolTip="{loc:LocKey Perf.CommitTooltip}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        ToolTip="{loc:LocKey Perf.HandlesTooltip}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="GDI: {0} · USER: {1}">
                                <Binding Path="GdiHandles" />
                                <Binding Path="UserHandles" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Text="{Binding RenderTier}"
                        ToolTip="{loc:LocKey Perf.TierTooltip}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSoftwareRendering}" Value="True">
                                        <Setter Property="Foreground" Value="#EB5757" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:LocKey Perf.WebView2}"
                        ToolTip="{loc:LocKey Perf.WebView2Tooltip}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding WebView2MemoryMB, StringFormat={}{0} MB}"
                        ToolTip="{loc:LocKey Perf.WebView2WsTooltip}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding WebView2Cpu, StringFormat={}{0:0.0}% CPU}"
                        ToolTip="{loc:LocKey Perf.WebView2CpuTooltip}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding WebView2ProcessCount, StringFormat={}{0} processes}"
                        ToolTip="{loc:LocKey Perf.BrowserVsChild}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:LocKey Perf.Group}"
                        ToolTip="{loc:LocKey Perf.GroupTooltip}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding GroupMemoryMB, StringFormat={}{0} MB}"
                        ToolTip="{loc:LocKey Perf.GroupWsTooltip}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding GroupCpu, StringFormat={}{0:0.0}% CPU}"
                        ToolTip="{loc:LocKey Perf.GroupCpuTooltip}" />
                </StackPanel>
            </Grid>
        </controls:CollapsibleGroupBox>

        <!--  WebView2 per-process breakdown (own row; collapses to zero height when empty)  -->
        <controls:CollapsibleGroupBox
            Grid.Row="2"
            Margin="12,0,12,4"
            IsExpanded="{Binding IsWebView2Expanded, Mode=TwoWay}">
            <controls:CollapsibleGroupBox.Style>
                <!--
                    BasedOn the implicit card style: a local Style without it would replace
                    the card template entirely (blank, zero-height section).
                -->
                <Style BasedOn="{StaticResource {x:Type controls:CollapsibleGroupBox}}" TargetType="{x:Type controls:CollapsibleGroupBox}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWebView2Processes}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:CollapsibleGroupBox.Style>
            <controls:CollapsibleGroupBox.HeaderContent>
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{loc:LocKey Perf.WebView2Processes}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:LocKey Perf.WebView2BreakdownHint}" />
                </Grid>
            </controls:CollapsibleGroupBox.HeaderContent>
            <DataGrid
                MaxHeight="120"
                Margin="4"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                ColumnHeaderHeight="24"
                FontSize="11"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding WebView2Processes}"
                RowHeaderWidth="0"
                RowHeight="22"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Pid}"
                        Header="{loc:LocKey Perf.PID}" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Kind}"
                        Header="{loc:LocKey Section.Settings.ColumnType}" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding MemoryMB, StringFormat={}{0} MB}"
                        Header="{loc:LocKey Perf.Memory}" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Cpu, StringFormat={}{0:0.0}%}"
                        Header="{loc:LocKey Perf.CPU}" />
                </DataGrid.Columns>
            </DataGrid>
        </controls:CollapsibleGroupBox>

        <!--  Per-window list  -->
        <controls:CollapsibleGroupBox
            Grid.Row="3"
            Margin="12,0,12,6"
            IsExpanded="{Binding IsWindowsExpanded, Mode=TwoWay}">
            <controls:CollapsibleGroupBox.HeaderContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{loc:LocKey Perf.WindowsWidgets}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            Padding="8,2"
                            Appearance="Secondary"
                            Click="SuspendIdle_Click"
                            Content="{loc:LocKey Perf.Suspend}"
                            FontSize="11"
                            ToolTip="{loc:LocKey Perf.SuspendTooltip}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Appearance="Secondary"
                            Click="ResumeAll_Click"
                            Content="{loc:LocKey Perf.Resume}"
                            FontSize="11"
                            ToolTip="{loc:LocKey Perf.ResumeTooltip}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding LayoutAnchorStatus}"
                        TextWrapping="Wrap"
                        ToolTip="{loc:LocKey Perf.RescaleTooltip}" />
                </Grid>
            </controls:CollapsibleGroupBox.HeaderContent>
            <Grid>
                <DataGrid
                    x:Name="WindowsGrid"
                    Margin="4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    ColumnHeaderHeight="24"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Items}"
                    PreviewMouseRightButtonDown="WindowsGrid_PreviewMouseRightButtonDown"
                    RowHeaderWidth="0"
                    RowHeight="22"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsAppDisabled, Converter={StaticResource BoolInvertedToVisibilityConverter}}">
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="HideSelected_Click" Header="{loc:LocKey Perf.Hide}" />
                            <MenuItem Click="ShowSelected_Click" Header="{loc:LocKey Perf.Show}" />
                            <Separator />
                            <MenuItem Click="SuspendSelected_Click" Header="{loc:LocKey Perf.Suspend}" />
                            <MenuItem Click="ResumeSelected_Click" Header="{loc:LocKey Perf.Resume}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Name}"
                            Header="{loc:LocKey Perf.Name}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Type}"
                            Header="{loc:LocKey Section.Settings.ColumnType}" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding IsVisible}"
                            Header="{loc:LocKey Section.Settings.ColumnVisible}" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Status}"
                            Header="{loc:LocKey Perf.Status}">
                            <DataGridTextColumn.CellStyle>
                                <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                            <Setter Property="Foreground" Value="#6FCF97" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Suspended">
                                            <Setter Property="Foreground" Value="#F2C94C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding ModelBounds}"
                            Header="{loc:LocKey Perf.ModelBounds}">
                            <DataGridTextColumn.CellStyle>
                                <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoundsMismatch}" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding AppliedBounds}"
                            Header="{loc:LocKey Perf.AppliedBounds}">
                            <DataGridTextColumn.CellStyle>
                                <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,1" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoundsMismatch}" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Margin="0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="{loc:LocKey Perf.Disabled}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAppDisabled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </controls:CollapsibleGroupBox>

        <controls:CollapsibleGroupBox
            Grid.Row="4"
            Margin="12,0,12,6"
            IsExpanded="{Binding IsLiveWallpaperExpanded, Mode=TwoWay}">
            <controls:CollapsibleGroupBox.HeaderContent>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*">
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{loc:LocKey Section.Settings.LiveWallpaper}" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Padding="8,2"
                            Appearance="Secondary"
                            Click="WallpaperSuspend_Click"
                            Content="{loc:LocKey Perf.Suspend}"
                            FontSize="11"
                            IsEnabled="{Binding LiveWallpaperEnabled}"
                            ToolTip="{loc:LocKey Perf.PauseWallpaperTooltip}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Appearance="Secondary"
                            Click="WallpaperResume_Click"
                            Content="{loc:LocKey Perf.Resume}"
                            FontSize="11"
                            IsEnabled="{Binding LiveWallpaperEnabled}"
                            ToolTip="{loc:LocKey Perf.ResumeWallpaperTooltip}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding LiveWallpaperSummary}"
                        TextWrapping="Wrap" />
                </Grid>
            </controls:CollapsibleGroupBox.HeaderContent>
            <Grid>
                <DataGrid
                    x:Name="LiveWallpaperGrid"
                    MaxHeight="150"
                    Margin="4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    ColumnHeaderHeight="24"
                    FontSize="11"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding LiveWallpaperMonitors}"
                    RowHeaderWidth="0"
                    RowHeight="22"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsLiveWallpaperDisabled, Converter={StaticResource BoolInvertedToVisibilityConverter}}">
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Device}"
                            Header="{loc:LocKey Perf.Monitor}" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding Bounds}"
                            Header="{loc:LocKey Perf.Bounds}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding File}"
                            Header="{loc:LocKey Perf.File}" />
                        <DataGridTextColumn
                            Width="60"
                            Binding="{Binding Renderer}"
                            Header="{loc:LocKey Section.Settings.ColumnType}" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding WebProcess}"
                            Header="{loc:LocKey Perf.WebPID}" />

                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Preloaded}"
                            Header="{loc:LocKey Perf.Preloaded}" />

                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Status}"
                            Header="{loc:LocKey Perf.Status}">
                            <DataGridTextColumn.CellStyle>
                                <Style BasedOn="{StaticResource DefaultDataGridCellStyle}" TargetType="DataGridCell">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Playing">
                                            <Setter Property="Foreground" Value="#6FCF97" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Paused">
                                            <Setter Property="Foreground" Value="#F2C94C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Engine down">
                                            <Setter Property="Foreground" Value="#EB5757" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding PauseReason}"
                            Header="{loc:LocKey Perf.PausedReason}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Margin="0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="{loc:LocKey Perf.WallpaperDisabled}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveWallpaperDisabled}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </controls:CollapsibleGroupBox>

        <Border
            Grid.Row="6"
            Padding="8,4"
            VerticalAlignment="Bottom"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                FontSize="10"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{loc:LocKey Perf.FooterHint}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</appwin:AppFluentWindow>
