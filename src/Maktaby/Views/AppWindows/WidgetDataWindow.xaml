<appwin:AppFluentWindow
    x:Class="Maktaby.Views.WidgetDataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appwin="clr-namespace:Maktaby.Views.AppWindows"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Maktaby.ViewModels"
    Title="Widget Editor"
    Width="1100"
    Height="700"
    MinWidth="900"
    MinHeight="500"
    d:DataContext="{Binding Source={x:Static appwin:DesignTimeData.SampleWidgetData}}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Shared title bar (AppFluentWindow): title syncs from Window.Title.  -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding TitleBar, RelativeSource={RelativeSource AncestorType={x:Type appwin:AppFluentWindow}}}"
            Focusable="False" />

        <!--  Manifest fields  -->
        <Border
            Grid.Row="1"
            Margin="12,8,12,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,0">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="NAME (FOLDER)" />
                    <ui:TextBox
                        x:Name="NameBox"
                        Margin="0,4,0,0"
                        PlaceholderText="MyWidget"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="OrangeRed"
                        Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=NameBox}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding (Validation.HasError), ElementName=NameBox}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,8,0">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="DESCRIPTION" />
                    <ui:TextBox
                        x:Name="DescBox"
                        Margin="0,4,0,0"
                        PlaceholderText="Description"
                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="VERSION" />
                    <ui:TextBox
                        x:Name="VersionBox"
                        Width="100"
                        Margin="0,4,0,0"
                        PlaceholderText="1.0.0"
                        Text="{Binding Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <!--
                    Size + options: Width/Height are fixed so they can never be squeezed out;
                    the option checkboxes wrap to a second line instead of clipping.
                -->
                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="AUTHOR" />
                        <ui:TextBox
                            x:Name="AuthorBox"
                            Width="200"
                            Margin="0,4,0,0"
                            PlaceholderText="Author"
                            Text="{Binding Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="WIDTH" />
                        <ui:TextBox
                            x:Name="WidthBox"
                            Width="90"
                            Margin="0,4,0,0"
                            PlaceholderText="300"
                            Text="{Binding WidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="HEIGHT" />
                        <ui:TextBox
                            x:Name="HeightBox"
                            Width="90"
                            Margin="0,4,0,0"
                            PlaceholderText="220"
                            Text="{Binding HeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <WrapPanel
                        Grid.Column="3"
                        Margin="0,8,0,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <CheckBox
                            x:Name="ResizableBox"
                            Margin="0,0,12,0"
                            Content="Resizable"
                            IsChecked="{Binding Resizable, Mode=TwoWay}" />
                        <CheckBox
                            x:Name="NetworkBox"
                            Margin="0,0,12,0"
                            Content="Allow network"
                            IsChecked="{Binding AllowNetwork, Mode=TwoWay}"
                            ToolTip="Allow fetch/XHR/WebSocket" />
                        <CheckBox
                            x:Name="ThemeSwitchBox"
                            Margin="0,0,0,0"
                            Checked="ThemeSwitchBox_Changed"
                            Content="Can switch theme"
                            Indeterminate="ThemeSwitchBox_Changed"
                            IsChecked="{Binding CanSwitchTheme, Mode=TwoWay}"
                            IsThreeState="True"
                            ToolTip="Widget adapts to Light/Dark app theme via data-theme (indeterminate = inherited / null)"
                            Unchecked="ThemeSwitchBox_Changed" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Editors + Preview  -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0">
                <TabControl.Resources>
                    <ContextMenu x:Key="EditorMenu" Opened="EditorMenu_Opened">
                        <MenuItem
                            Click="EditorCut_Click"
                            Header="Cut"
                            InputGestureText="Ctrl+X" />
                        <MenuItem
                            Click="EditorCopy_Click"
                            Header="Copy"
                            InputGestureText="Ctrl+C" />
                        <MenuItem
                            x:Name="MenuEditPaste"
                            Click="EditorPaste_Click"
                            Header="Paste"
                            InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem
                            Click="EditorSelectAll_Click"
                            Header="Select All"
                            InputGestureText="Ctrl+A" />
                    </ContextMenu>
                </TabControl.Resources>
                <TabItem Header="HTML">
                    <Grid>
                        <Border
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <avalonEdit:TextEditor
                                x:Name="HtmlBox"
                                Padding="6,4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                ContextMenu="{StaticResource EditorMenu}"
                                Document="{Binding HtmlDocument}"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                HorizontalScrollBarVisibility="Auto"
                                LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                                ShowLineNumbers="True"
                                SyntaxHighlighting="HTML"
                                VerticalScrollBarVisibility="Auto"
                                WordWrap="False" />
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="CSS">
                    <Grid>
                        <Border
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <avalonEdit:TextEditor
                                x:Name="CssBox"
                                Padding="6,4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                ContextMenu="{StaticResource EditorMenu}"
                                Document="{Binding CssDocument}"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                HorizontalScrollBarVisibility="Auto"
                                LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                                ShowLineNumbers="True"
                                SyntaxHighlighting="CSS"
                                VerticalScrollBarVisibility="Auto"
                                WordWrap="False" />
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="JavaScript">
                    <Grid>
                        <Border
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <avalonEdit:TextEditor
                                x:Name="JsBox"
                                Padding="6,4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                ContextMenu="{StaticResource EditorMenu}"
                                Document="{Binding JsDocument}"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                HorizontalScrollBarVisibility="Auto"
                                LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                                ShowLineNumbers="True"
                                SyntaxHighlighting="JavaScript"
                                VerticalScrollBarVisibility="Auto"
                                WordWrap="False" />
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Center"
                Background="Transparent" />

            <Border
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Padding="8"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8,8,0,0">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="PREVIEW" />
                            <ui:Button
                                HorizontalAlignment="Right"
                                Appearance="Transparent"
                                Click="PreviewRefresh_Click"
                                Content="Refresh"
                                Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Margin="8"
                        Background="White"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ContentControl x:Name="PreviewHost" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="12,8"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="User widgets stored in %LocalAppData%\Maktaby\UserWidgets" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Secondary"
                        Click="Cancel_Click"
                        Content="Cancel" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Click="Save_Click"
                        Content="Save" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Saving overlay: staged progress for the async save pipeline (verify, write,
          thumbnail, reload). The ring's IsIndeterminate is driven in code together with
          Visibility — never just hidden — so no loop runs while collapsed.  -->
        <Grid
            x:Name="SavingOverlay"
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#80000000"
            Visibility="Collapsed">
            <Border
                MinWidth="260"
                MaxWidth="380"
                Padding="20,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="Saving widget..." />
                    <ui:ProgressRing
                        x:Name="SaveProgressRing"
                        Width="32"
                        Height="32"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        IsIndeterminate="False" />
                    <TextBlock
                        x:Name="SaveStatusText"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Working..."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</appwin:AppFluentWindow>
