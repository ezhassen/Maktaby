<appwin:AppFluentWindow
    x:Class="Maktaby.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appwin="clr-namespace:Maktaby.Views.AppWindows"
    xmlns:conv="clr-namespace:Maktaby.Converters"
    xmlns:loc="clr-namespace:Maktaby.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Maktaby.ViewModels"
    Title="{loc:LocKey Section.Settings.Title}"
    Width="720"
    Height="640"
    MinWidth="560"
    MinHeight="480"
    d:DataContext="{Binding Source={x:Static appwin:DesignTimeData.SampleSettings}}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <appwin:AppFluentWindow.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:HexValidToBrushConverter x:Key="HexValidToBrush" />

        <!--  Borderless, rounded reset-to-default button. Tooltip "Reset".  -->
        <Style
            x:Key="ResetButton"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="ToolTip" Value="Reset to default" />
        </Style>
    </appwin:AppFluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Shared title bar (AppFluentWindow): title syncs from Window.Title.  -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding TitleBar, RelativeSource={RelativeSource AncestorType={x:Type appwin:AppFluentWindow}}}"
            Focusable="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <ListBox
                    x:Name="CategoryList"
                    Background="Transparent"
                    BorderThickness="0"
                    PreviewMouseLeftButtonDown="CategoryList_PreviewMouseDown"
                    SelectedIndex="0">
                    <ListBoxItem Content="{loc:LocKey Section.Settings.Preview}" Tag="SectionPreview" />
                    <ListBoxItem Content="{loc:LocKey Section.Settings.Appearance}" Tag="SectionAppearance" />
                    <ListBoxItem Content="{loc:LocKey Section.Settings.Boxes}" Tag="SectionBoxes" />
                    <ListBoxItem Content="{loc:LocKey WidgetsList.Title}" Tag="SectionWebWidgets" />
                    <ListBoxItem Content="{loc:LocKey Section.Settings.Containers}" Tag="SectionContainers" />
                    <ListBoxItem Content="{loc:LocKey Section.Settings.LiveWallpaper}" Tag="SectionLiveWallpaper" />
                    <ListBoxItem
                        x:Name="listBoxItem_SectionUpdates"
                        Content="{loc:LocKey Section.Settings.Updates}"
                        Tag="SectionUpdates" />
                    <ListBoxItem Content="{loc:LocKey Section.Settings.General}" Tag="SectionGeneral" />
                    <ListBoxItem Content="{loc:LocKey Section.Settings.Snapshot}" Tag="SectionSnapshot" />
                </ListBox>
            </Border>

            <ScrollViewer
                x:Name="ContentScroll"
                Grid.Column="1"
                Padding="16,8,16,8"
                ScrollChanged="ContentScroll_ScrollChanged"
                SizeChanged="ContentScroll_SizeChanged"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox
                        x:Name="SectionPreview"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.Preview}">
                        <Border
                            x:Name="PreviewDesktop"
                            Padding="16"
                            CornerRadius="8">
                            <Border
                                x:Name="PreviewBox"
                                Width="320"
                                Height="160"
                                Padding="0"
                                CornerRadius="8">
                                <DockPanel LastChildFill="True">
                                    <Border
                                        x:Name="PreviewHeader"
                                        Height="24"
                                        CornerRadius="8,8,0,0"
                                        DockPanel.Dock="Top">
                                        <TextBlock
                                            x:Name="PreviewTitle"
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{loc:LocKey Section.Settings.BoxTitle}" />
                                    </Border>
                                    <WrapPanel
                                        x:Name="PreviewBody"
                                        Margin="8"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal" />
                                </DockPanel>
                            </Border>
                        </Border>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionAppearance"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.Appearance}">
                        <StackPanel Margin="8">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKeyBilingual Section.Settings.Language}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.LanguageHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding LanguageOptions}"
                                        SelectedItem="{Binding LanguageOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="LanguageOption"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.AppTheme}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.AppThemeHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding AppThemeOptions}"
                                        SelectedItem="{Binding SelectedThemeOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="SelectedThemeOption"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.WindowBackdrop}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.WindowBackdropHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding WindowBackdropOptions}"
                                        SelectedItem="{Binding WindowBackdropOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="WindowBackdropOption"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.DefaultBoxTransparency}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="0 = opaque .. 1 = transparent." />
                                <StackPanel Orientation="Horizontal">
                                    <Slider
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Maximum="1"
                                        Minimum="0"
                                        TickFrequency="0.05"
                                        Value="{Binding DefaultBoxTransparencyValue}" />
                                    <TextBlock
                                        Width="48"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding DefaultBoxTransparencyValue, StringFormat={}{0:0.00}}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="DefaultBoxTransparencyValue"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionBoxes"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.Boxes}">
                        <StackPanel Margin="8">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.DefaultBoxTheme}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.DefaultBoxThemeHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding BoxThemeOptions}"
                                        SelectedItem="{Binding DefaultBoxThemeOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="DefaultBoxThemeOption"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.DefaultBoxIconSize}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.DefaultBoxIconSizeHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <Slider
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Maximum="128"
                                        Minimum="16"
                                        TickFrequency="8"
                                        Value="{Binding DefaultBoxIconSize}" />
                                    <TextBlock
                                        Width="64"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding DefaultBoxIconSize, TargetNullValue=Auto, StringFormat={}{0:0} px}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="DefaultBoxIconSize"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <GroupBox Margin="0,4,0,8" Header="{loc:LocKey Section.Settings.DefaultBoxColors}">
                                <StackPanel Margin="8">
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="{loc:LocKey Section.Settings.Background}" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxBackColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxBackColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxBackColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Click="ColorPicker_Click"
                                            Style="{StaticResource ResetButton}"
                                            Tag="DefaultBoxBackColor"
                                            ToolTip="{loc:LocKey ColorPicker.Title}">
                                            <ui:SymbolIcon Symbol="Color24" />
                                        </ui:Button>
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxBackColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="{loc:LocKey Section.Settings.Foreground}" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxForeColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxForeColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxForeColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Click="ColorPicker_Click"
                                            Style="{StaticResource ResetButton}"
                                            Tag="DefaultBoxForeColor"
                                            ToolTip="{loc:LocKey ColorPicker.Title}">
                                            <ui:SymbolIcon Symbol="Color24" />
                                        </ui:Button>
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxForeColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="{loc:LocKey Section.Settings.Border}" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxBorderColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxBorderColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxBorderColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Click="ColorPicker_Click"
                                            Style="{StaticResource ResetButton}"
                                            Tag="DefaultBoxBorderColor"
                                            ToolTip="{loc:LocKey ColorPicker.Title}">
                                            <ui:SymbolIcon Symbol="Color24" />
                                        </ui:Button>
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxBorderColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="{loc:LocKey Section.Settings.TitleBarBack}" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxTitleBarBackColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxTitleBarBackColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxTitleBarBackColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Click="ColorPicker_Click"
                                            Style="{StaticResource ResetButton}"
                                            Tag="DefaultBoxTitleBarBackColor"
                                            ToolTip="{loc:LocKey ColorPicker.Title}">
                                            <ui:SymbolIcon Symbol="Color24" />
                                        </ui:Button>
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxTitleBarBackColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="{loc:LocKey Section.Settings.TitleBarFore}" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxTitleBarForeColor, UpdateSourceTrigger=PropertyChanged}" />
                                        <Rectangle
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Fill="{Binding DefaultBoxTitleBarForeColor, Converter={StaticResource HexToBrush}}"
                                            Stroke="{Binding DefaultBoxTitleBarForeColor, Converter={StaticResource HexValidToBrush}}"
                                            StrokeThickness="1" />
                                        <ui:Button
                                            Click="ColorPicker_Click"
                                            Style="{StaticResource ResetButton}"
                                            Tag="DefaultBoxTitleBarForeColor"
                                            ToolTip="{loc:LocKey ColorPicker.Title}">
                                            <ui:SymbolIcon Symbol="Color24" />
                                        </ui:Button>
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxTitleBarForeColor"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Width="120"
                                            VerticalAlignment="Center"
                                            Text="{loc:LocKey Section.Settings.BorderThickness}" />
                                        <ui:TextBox Width="120" Text="{Binding DefaultBoxBorderThickness, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxBorderThickness"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <CheckBox
                                            Margin="0,4,0,0"
                                            Content="{loc:LocKey Section.Settings.TitleBarUsesBoxColors}"
                                            IsChecked="{Binding DefaultBoxTitleBarColorsSameAsBox}" />
                                        <ui:Button
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ResetToDefaultCommand}"
                                            CommandParameter="DefaultBoxTitleBarColorsSameAsBox"
                                            Style="{StaticResource ResetButton}">
                                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                        </ui:Button>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionWebWidgets"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey WidgetsList.Title}">
                        <StackPanel Margin="8">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.DefaultWidgetsTheme}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.DefaultWidgetsThemeHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding WebWidgetThemeOptions}"
                                        SelectedItem="{Binding DefaultWebWidgetsThemeOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="DefaultWebWidgetsThemeOption"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionContainers"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.Containers}">
                        <StackPanel Margin="8">
                            <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.ContainersVisibility}" />
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                Foreground="#999999"
                                Text="{loc:LocKey Section.Settings.ContainersVisibilityHint}" />
                            <DataGrid
                                x:Name="ContainersGrid"
                                MaxHeight="220"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                IsReadOnly="False"
                                ItemsSource="{Binding Containers}"
                                PreviewKeyDown="ContainersGrid_PreviewKeyDown"
                                RowHeaderWidth="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionMode="Single"
                                SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Title}"
                                        Header="{loc:LocKey Section.Settings.ColumnTitle}"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding TypeDisplay}"
                                        Header="{loc:LocKey Section.Settings.ColumnType}"
                                        IsReadOnly="True" />
                                    <DataGridTemplateColumn Width="70" Header="{loc:LocKey Section.Settings.ColumnVisible}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox
                        x:Name="SectionLiveWallpaper"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.LiveWallpaper}">
                        <StackPanel Margin="8">
                            <StackPanel Margin="12,12,0,8">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.LiveWallpaperPreload}" />
                                <TextBlock
                                    Margin="4,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.LiveWallpaperPreloadHint}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox
                                        Width="150"
                                        HorizontalAlignment="Left"
                                        ClearButtonEnabled="False"
                                        LargeChange="10"
                                        Maximum="1024"
                                        Minimum="0"
                                        SmallChange="1"
                                        TextAlignment="Center"
                                        Value="{Binding LiveWallpaperPreloadMaxMB, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="LiveWallpaperPreloadMaxMB"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#999999"
                                        Text="{loc:LocKey Section.Settings.MB}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox
                        x:Name="SectionUpdates"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.Updates}">
                        <StackPanel Margin="8">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.UpdateChannel}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.UpdateChannelHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        ItemsSource="{Binding UpdateChannelOptions}"
                                        SelectedItem="{Binding UpdateChannel, UpdateSourceTrigger=PropertyChanged}" />
                                    <!--
                                        CommandParameter MUST be the UserSettings property name:
                                        the reset command reflects it. "UpdateChannel", never
                                        "SelectedUpdateChannelOption".
                                    -->
                                    <ui:Button
                                        Command="{Binding ResetToDefaultCommand}"
                                        CommandParameter="UpdateChannel"
                                        Style="{StaticResource ResetButton}">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="{loc:LocKey Section.Settings.CheckForUpdatesAuto}"
                                    IsChecked="{Binding CheckForUpdatesOnStartup}" />
                                <ui:Button
                                    Command="{Binding ResetToDefaultCommand}"
                                    CommandParameter="CheckForUpdatesOnStartup"
                                    Style="{StaticResource ResetButton}">
                                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                                </ui:Button>
                            </StackPanel>

                            <TextBlock
                                Margin="0,0,0,8"
                                FontSize="11"
                                Foreground="#999999"
                                Text="{loc:LocKey Section.Settings.CheckForUpdatesAutoHint}"
                                TextWrapping="Wrap" />

                            <ui:Button
                                Padding="8,2"
                                HorizontalAlignment="Left"
                                Appearance="Secondary"
                                Click="CheckForUpdatesNow_Click"
                                Content="{loc:LocKey Section.Settings.CheckNow}"
                                Icon="{StaticResource ItemIcon_Update}" />

                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="11"
                                Foreground="#999999"
                                Text="{loc:LocKey Section.Settings.UpdatesNeedInternet}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionGeneral"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.General}">
                        <StackPanel Margin="8">
                            <CheckBox Content="{loc:LocKey Section.Settings.LaunchOnStartup}" IsChecked="{Binding LaunchOnStartup}" />
                            <StackPanel Margin="12,12,0,8">
                                <TextBlock FontWeight="Bold" Text="{loc:LocKey Section.Settings.LogLevel}" />
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{loc:LocKey Section.Settings.LogLevelHint}" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding LogLevelOptions}"
                                        SelectedItem="{Binding SelectedLogLevelOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Appearance="Secondary"
                                        Click="ViewLogs_Click"
                                        Content="{loc:LocKey Section.Settings.ViewLogs}"
                                        ToolTip="{loc:LocKey Section.Settings.ViewLogsTooltip}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox
                        x:Name="SectionSnapshot"
                        Margin="0,0,0,12"
                        Header="{loc:LocKey Section.Settings.Snapshot}">
                        <StackPanel Margin="8">
                            <TextBlock
                                FontSize="11"
                                Foreground="#999999"
                                Text="{loc:LocKey Section.Settings.SnapshotHint}" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Click="Backup_Click"
                                    Content="{loc:LocKey Section.Settings.Backup}" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Click="Restore_Click"
                                    Content="{loc:LocKey Section.Settings.Restore}" />
                                <ui:Button
                                    Appearance="Danger"
                                    Click="ResetSnapshot_Click"
                                    Content="{loc:LocKey Tray.Reset}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="11"
                                Foreground="#C0392B"
                                Text="{loc:LocKey Section.Settings.ResetWarning}" />
                        </StackPanel>
                    </GroupBox>

                    <!--  Spacer: sized in code-behind so the last section can scroll up to the top.  -->
                    <Border x:Name="BottomSpacer" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="16,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Width="80"
                Margin="0,0,8,0"
                Appearance="Secondary"
                Click="Cancel_Click"
                Content="{loc:LocKey Section.Settings.Cancel}" />
            <ui:Button
                Width="80"
                Appearance="Primary"
                Click="Save_Click"
                Content="{loc:LocKey Section.Settings.Save}" />
        </StackPanel>

        <ui:ContentDialogHost
            x:Name="RootContentDialogHost"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</appwin:AppFluentWindow>
