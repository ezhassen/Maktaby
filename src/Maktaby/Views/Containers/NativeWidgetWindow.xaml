<containers:WidgetWindow
    x:Class="Maktaby.Views.Containers.NativeWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:Maktaby.AttachedProperties"
    xmlns:containers="clr-namespace:Maktaby.Views.Containers"
    xmlns:containersControls="clr-namespace:Maktaby.Controls.ContainersControls"
    xmlns:controls="clr-namespace:Maktaby.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Widget"
    Width="300"
    Height="220"
    MinWidth="120"
    MinHeight="80"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu x:Name="WidgetMenu" Opened="WidgetMenu_Opened">
                <MenuItem Click="Change_Click" Header="Change Widget">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="SettingsMenuItem"
                    Click="Settings_Click"
                    Header="Widget Settings…"
                    Visibility="Collapsed">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Settings20" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="Duplicate_Click" Header="Duplicate">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Copy24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="LockMenuItem"
                    Click="Lock_Click"
                    Header="Lock"
                    IsCheckable="True" />
                <MenuItem
                    x:Name="HideMenuItem"
                    Click="Hide_Click"
                    Header="Hide">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Click="Delete_Click"
                    Foreground="OrangeRed"
                    Header="Delete"
                    Icon="{StaticResource ItemIcon_Delete}" />
            </ContextMenu>
        </Grid.ContextMenu>
        <ContentControl x:Name="WidgetHost" />
    </Grid>
</containers:WidgetWindow>
