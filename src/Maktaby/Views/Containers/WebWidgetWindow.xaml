<containers:WidgetWindow
    x:Class="Maktaby.Views.Containers.WebWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:Maktaby.AttachedProperties"
    xmlns:containers="clr-namespace:Maktaby.Views.Containers"
    xmlns:containersControls="clr-namespace:Maktaby.Controls.ContainersControls"
    xmlns:controls="clr-namespace:Maktaby.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:Maktaby.Localization"
    Title="Widget"
    Width="300"
    Height="220"
    MinWidth="120"
    MinHeight="80"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu x:Name="WidgetMenu" Opened="WidgetMenu_Opened">
                <MenuItem Click="Change_Click" Header="{loc:LocKey WidgetMenu.ChangeWidget}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="WidgetMenuEdit"
                    Click="Edit_Click"
                    Header="{loc:LocKey WidgetsList.Edit}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Edit24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="Duplicate_Click" Header="{loc:LocKey WidgetsList.Duplicate}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Copy24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    x:Name="LockMenuItem"
                    Click="Lock_Click"
                    Header="{loc:LocKey Box.MenuLock}"
                    IsCheckable="True" />
                <MenuItem
                    x:Name="HideMenuItem"
                    Click="Hide_Click"
                    Header="{loc:LocKey Box.MenuHide}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    Click="Delete_Click"
                    Foreground="OrangeRed"
                    Header="{loc:LocKey Box.MenuDelete}"
                    Icon="{StaticResource ItemIcon_Delete}" />
            </ContextMenu>
        </Grid.ContextMenu>
        <ContentControl x:Name="WidgetHost" />
    </Grid>


