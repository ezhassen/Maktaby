<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Maktaby.Core.Models">

    <!--  Implicit data template for a BoxItem used by BoxControl's item list.  -->
    <DataTemplate DataType="{x:Type models:BoxItem}">
        <TextBlock
            Margin="2"
            Foreground="White"
            Text="{Binding DisplayName}" />
    </DataTemplate>

</ResourceDictionary>
