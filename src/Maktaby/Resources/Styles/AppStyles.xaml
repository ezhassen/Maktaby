    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Maktaby.Controls"
    xmlns:conv="clr-namespace:Maktaby.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

