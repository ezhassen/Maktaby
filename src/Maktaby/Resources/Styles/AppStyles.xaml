    <!--
        Update / "check for the latest build". Two-arrow sync loop: the universal refresh
        glyph, and it matches the menu item's verb ("Check for updates..."). A download-arrow
        icon was rejected because it reads as the RESULT rather than the action.
        The *20 Filled variant keeps it consistent with ItemIcon_About (Info20) and
        ItemIcon_ThemeLight (WeatherSunny20).
    -->
    <ui:SymbolIcon
        x:Key="ItemIcon_Update"
        x:Shared="False"
        FontSize="16"
        Symbol="ArrowSync20" />

    <!--
        Box appearance resources. These are resolved from UserSettings by BoxAppearance and
        applied at runtime (App.ApplyBoxAppearance / BoxContainerWindow.ApplyAppearance), so
        boxes follow the configured theme and colors. Declared here only as safe defaults.
    -->

    <!--
        Borderless button that blends into its parent (transparent background, no border).
        Used for the title-bar icon buttons (menu, roll).
    -->
    <Style x:Key="BorderlesButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Background" Property="Background" Value="#24FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Background" Property="Background" Value="#3BFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Chevron toggle for collapsible card headers (Performance Monitor WebView2 section, ...).
        Bind IsChecked two-way to the VM expanded flag. The chevron points down when expanded
        and rotates to point right when collapsed; hover/pressed follow the BorderlesButtonStyle
        pattern with theme-aware fills.
    -->
    <Style x:Key="ToggleButtonCollapsable" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="PART_Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Path
                            x:Name="PART_Chevron"
                            Width="10"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 1 1 L 5 5 L 9 1"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="None"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.6">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Background" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Background" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="PART_Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Fixed WPF-UI menu item templates.
        
        The stock WPF-UI MenuItem.SubmenuHeaderTemplate applies a template-local DropShadowEffect and
        offsets that make submenus OVERLAP their parent item instead of opening beside it whenever the
        menu opens upward (bottom-anchored). These app-wide replacements remove the shadow, anchor the
        submenu Popup to the RIGHT of its parent row, and ADD what the stock templates lack: a check
        gutter so IsCheckable items (tray "Hide All Boxes", per-box "Icon Size" presets, ...) render
        their checked state.
    -->
    <ControlTemplate x:Key="FixedSubmenuItemTemplate" TargetType="MenuItem">
        <Border
            x:Name="Border"
            Margin="4,1,4,1"
            Background="Transparent"
            CornerRadius="4">
            <Grid Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Check box: 20x20 rounded, own column (never overlaps icon). Uses WPF-UI's
                    themed CheckBoxBackground/CheckBoxBorderBrush (not hardcoded) so it matches
                    the stock checkbox exactly. Visible only when IsCheckable.
                -->
                <Border
                    x:Name="CheckBoxIconBorder"
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CheckBoxBackground}"
                    BorderBrush="{DynamicResource CheckBoxBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CheckBoxIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource FluentSystemIcons}"
                        FontSize="16"
                        Text=""
                        TextAlignment="Center" />
                </Border>

                <ContentPresenter
                    x:Name="Icon"
                    Grid.Column="1"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Icon}"
                    KeyboardNavigation.IsTabStop="False" />

                <ContentPresenter
                    x:Name="Header"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </MultiTrigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="CheckBoxIconBorder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxIcon" Property="Text" Value="&#xF294;" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Submenu header — WPF-UI's EXACT template (from its MenuItem.xaml source), with ONLY the
        DropShadowEffect removed. The details that make it work and that I previously got wrong:
        * two-row Grid, Border in Row 1, Popup in Row 1;
        * Popup Placement="Right", PlacementTarget=MenuItemContent (the inner Grid, NOT Border),
        VerticalOffset="-20";
        * SubmenuBorder Margin="12,10,12,30" — those transparent margins are the HIT-TESTABLE
        BRIDGE that keeps the submenu open as the cursor crosses from the parent item; without
        them the submenu closes on hover. Padding 0,3,0,3, CornerRadius 8.
        Do NOT "simplify" this into a single row or change the placement — it breaks hover.
    -->
    <ControlTemplate x:Key="FixedSubmenuHeaderTemplate" TargetType="MenuItem">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="Border"
                Grid.Row="1"
                Margin="4,1,4,1"
                Background="Transparent"
                CornerRadius="4">
                <Grid x:Name="MenuItemContent" Margin="8,6,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter
                        x:Name="Icon"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Icon}"
                        KeyboardNavigation.IsTabStop="False" />

                    <ContentPresenter
                        x:Name="Header"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True" />

                    <ui:SymbolIcon
                        x:Name="Chevron"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"
                        Symbol="ChevronRight20" />
                </Grid>
            </Border>

            <Popup
                x:Name="Popup"
                Grid.Row="1"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{TemplateBinding IsSubmenuOpen}"
                Placement="Right"
                PlacementTarget="{Binding ElementName=MenuItemContent}"
                PopupAnimation="None">
                <!--
                    Wrapper Grid carries the hit-testable transparent margin (Background=Transparent
                    is hit-testable; a null background is click-through). This is the bridge that
                    keeps the submenu open as the cursor crosses from the parent item — WPF-UI's
                    original used a DropShadowEffect to fill this area, but the shadow also broke
                    placement, so a transparent hit-testable surface replaces it. Vertical placement
                    is set dynamically by MenuItemSubmenuPlacement (top-aligned, direction-safe).
                -->
                <Grid Margin="12,10,12,30" Background="Transparent">
                    <Border
                        x:Name="SubmenuBorder"
                        Padding="0,3,0,3"
                        Background="{DynamicResource FlyoutBackground}"
                        BorderBrush="{DynamicResource FlyoutBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Icon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Modern top-level MenuItem template.
        
        Stock WPF-UI leaves Role="TopLevelItem"/"TopLevelHeader" (the direct rows of a ContextMenu —
        the box right-click menu, the tray menu) on its own templates, which are visually
        inconsistent with the rounded, check-gutter submenu rows above (square corners, different
        padding/hover). This template makes every level look identical: a rounded 5px hover pill,
        a modern 16x16 check box, a leading icon gutter, and Win11 padding (8,7,8,7).
        MUST be declared before the role-routed style below that references it via StaticResource
        (StaticResource cannot forward-reference within a dictionary).
    -->
    <ControlTemplate x:Key="FixedTopLevelItemTemplate" TargetType="MenuItem">
        <Border
            x:Name="Border"
            Margin="4,2"
            Background="Transparent"
            CornerRadius="4">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Check box: 20x20 rounded, own column (never overlaps icon). WPF-UI's themed
                    CheckBoxBackground/CheckBoxBorderBrush + Fluent checkmark glyph.
                -->
                <Border
                    x:Name="CheckBoxIconBorder"
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CheckBoxBackground}"
                    BorderBrush="{DynamicResource CheckBoxBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CheckBoxIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource FluentSystemIcons}"
                        FontSize="16"
                        Text=""
                        TextAlignment="Center" />
                </Border>

                <!--  Leading icon (the app's ItemIcon_* SymbolIcons).  -->
                <ContentPresenter
                    x:Name="Icon"
                    Grid.Column="1"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Icon}"
                    KeyboardNavigation.IsTabStop="False" />

                <ContentPresenter
                    x:Name="Header"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!--
                Hover/pressed: theme-aware subtle fill (WPF-UI's own menu highlight), not a
                hardcoded white wash — so it reads on both the dark and light flyout.
            -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="CheckBoxIconBorder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxIcon" Property="Text" Value="&#xF294;" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Icon" Property="Margin" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Role-routed application of the fixed templates. Submenu* roles get the anchored submenu
        templates; the two top-level roles (TopLevelItem / TopLevelHeader — the direct rows of a
        ContextMenu) get the modern templates so every level looks identical. NOTE: the WPF
        MenuItemRole enum has NO "MenuItem" value — the plain clickable row is "TopLevelItem".
    -->
    <Style x:Key="MenuItemFix01" TargetType="MenuItem">
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource FixedSubmenuHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource FixedSubmenuItemTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource FixedTopLevelItemTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource FixedSubmenuHeaderTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Modern ContextMenu chrome (Win11 compact look).
        
        Rounded 8px corners, no hard border (the edge is defined by the flyout background against
        its surroundings), app-theme background via FlyoutBackground. IMPORTANT: NO Effect/DropShadow
        on this Border — a shadow here extends the hit-testable surface beyond the menu bounds,
        which breaks the MenuItem submenu mouse-tracking (the submenu closes as the cursor crosses
        the shadow on its way to the submenu). The menu stays flat; shadow is intentionally omitted.
        Implicit, so every ContextMenu in the app (box menu, tray, editor menu, ...) picks it up.
        Items keep their own per-role templates (routed above); this only styles the frame.
    -->
    <Style x:Key="ContextMenuFix01" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource FlyoutBackground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Separator between menu groups: a thin, inset hairline that matches the modern menu look
        (stock WPF-UI separators are full-width and heavier).
    -->
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="10,4,10,4" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource FlyoutBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        CollapsibleGroupBox (Controls/CollapsibleGroupBox.cs): card with a clickable header
        (chevron + HeaderContent) that collapses the Content body. Implicit so every
        instance picks it up; Margin comes from the instance, body inset from BodyPadding.
    -->
    <Style TargetType="{x:Type controls:CollapsibleGroupBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CollapsibleGroupBox}">
                    <Border
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <!--
                                    Star (not Auto): children like DataGrid report their full
                                    content height as DesiredSize and never clamp it — an Auto
                                    body row would arrange them at that height (spilling past
                                    the card with no scrollbar), while star arranges them in
                                    the card's actual height so their internal scroller engages.
                                    Under an infinite outer constraint star behaves as Auto,
                                    so shrink-wrapping sections are unaffected.
                                -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="PART_HeaderBorder"
                                Grid.Row="0"
                                Padding="8,4"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="8,8,0,0"
                                Cursor="Hand"
                                ToolTip="Click to collapse / expand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Style="{StaticResource ToggleButtonCollapsable}"
                                        ToolTip="Collapse / expand" />
                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        ContentSource="Header" />
                                </Grid>
                            </Border>
                            <ContentPresenter
                                x:Name="PART_Body"
                                Grid.Row="1"
                                Margin="{TemplateBinding BodyPadding}"
                                ContentSource="Content" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="PART_HeaderBorder" Property="CornerRadius" Value="8" />
                            <Setter TargetName="PART_Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
