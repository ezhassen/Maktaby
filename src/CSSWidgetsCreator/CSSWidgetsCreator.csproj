<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>

		<IsTrimmable>false</IsTrimmable>
		<EnableAot>false</EnableAot>
		<Platforms>AnyCPU;x64</Platforms>

		<Authors>Ezz Hassan</Authors>
		<Company>Ezz Hassan</Company>
		<PublisherName>Ezz Hassan</PublisherName>
		<Copyright>Copyright ©  2026</Copyright>
	
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WPFShared\WPFShared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="WPF-UI" Version="4.3.0" />

		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
		<PackageReference Include="MinVer" Version="7.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
	</ItemGroup>
</Project>
