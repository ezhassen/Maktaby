<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>$(SharedTargetFrameworWindows)</TargetFramework>
		<TargetPlatformMinVersion>$(SharedTargetPlatformMinVersion)</TargetPlatformMinVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<IsTrimmable>false</IsTrimmable>
		<EnableAot>false</EnableAot>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WPFShared\WPFShared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWin32">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="WPF-UI" />
		<PackageReference Include="Microsoft.Web.WebView2" />
		<PackageReference Include="Serilog" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
	</ItemGroup>
</Project>