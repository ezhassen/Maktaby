<UserControl
    x:Class="Maktaby.Shared.Controls.WebWidgetControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="#01000000">
        <wv2:WebView2 x:Name="WebView" Visibility="Visible" />
        <!--<wv2:WebView2CompositionControl x:Name="WebView" AllowExternalDrop="False" />-->
        <ui:InfoBar
            x:Name="ErrorBar"
            Title="WebView2 unavailable"
            Margin="8"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="False"
            Message="Microsoft Edge WebView2 Runtime not found. Install Evergreen runtime to display widgets."
            Severity="Error" />
        <TextBlock
            x:Name="PlaceholderText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource WindowBackground}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="No widget"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
