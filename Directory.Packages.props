<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<GlobalPackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<!--<GlobalPackageReference Include="Serilog" Version="4.4.0" />-->

		<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<!-- Runtime Roslyn compile of native-widget sources (NativeWidgetService). -->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
		<PackageVersion Include="Microsoft.Windows.Compatibility" Version="10.0.11" />
		<PackageVersion Include="Serilog" Version="4.4.0" />
		<PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
		<PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageVersion Include="System.Drawing.Common" Version="10.0.11" />
		<PackageVersion Include="Vortice.Direct2D1" Version="3.8.3" />
		<PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
		<PackageVersion Include="Vortice.DirectComposition" Version="3.8.3" />
		<PackageVersion Include="WPF-UI" Version="4.3.0" />
		<PackageVersion Include="WPF-UI.Tray" Version="4.3.0" />
	</ItemGroup>
</Project>
